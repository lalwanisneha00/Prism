{
  "description": "Key facts a correct lesson on each topic must state. Patterns are case-insensitive regular expressions matched against the lesson's text after LaTeX backslashes and braces are removed (so \\frac{Q}{\\varepsilon_0} reads as fracqvarepsilon_0).",
  "subject": "em",
  "topics": [
    {
      "topic": "coulombs-law",
      "chapter": "electrostatics",
      "facts": [
        {
          "id": "inverse-square",
          "claim": "Force falls with the square of distance",
          "pattern": "inverse[- ]square|r\\^2|r squared"
        },
        {
          "id": "constant",
          "claim": "k ≈ 8.99 × 10^9 N·m²/C² (= 1/4πε₀)",
          "pattern": "8\\.99?\\d*\\s*(×|times|x)\\s*10\\^9|9\\s*(×|times|x)\\s*10\\^9|frac\\s*1\\s*4\\s*pi\\s*(var)?epsilon_?0|1\\s*/\\s*\\(?4\\s*pi\\s*(var)?epsilon_?0"
        },
        {
          "id": "like-repel",
          "claim": "Like charges repel",
          "pattern": "like charges repel|same sign[^.]{0,40}repel|repel[^.]{0,40}same sign"
        }
      ]
    },
    {
      "topic": "electric-field",
      "chapter": "electrostatics",
      "facts": [
        {
          "id": "definition",
          "claim": "Field = force per unit charge",
          "pattern": "force per (unit )?(positive )?(test )?charge|per coulomb|frac\\s*(vec\\s*)?f\\s*q|f\\s*/\\s*q"
        },
        {
          "id": "units",
          "claim": "Units N/C (or V/m)",
          "pattern": "n/c|newtons? per coulomb|v/m|volts? per met(re|er)"
        },
        {
          "id": "direction",
          "claim": "Points away from positive charge",
          "pattern": "away from (a |the |any )?positive|outward from (a |the )?positive|points? away"
        }
      ]
    },
    {
      "topic": "gauss-law",
      "chapter": "electrostatics",
      "facts": [
        {
          "id": "statement",
          "claim": "Net flux = Q_enc / ε₀",
          "pattern": "frac\\s*q_?(text)?\\s*enc\\s*(var)?epsilon_?0|q_?(text)?\\s*enc\\s*/\\s*(var)?epsilon_?0|enclosed charge (divided by|over) (epsilon|ε)"
        },
        {
          "id": "closed-surface",
          "claim": "Applies to a closed (Gaussian) surface",
          "pattern": "closed surface|gaussian surface"
        },
        {
          "id": "outside-zero",
          "claim": "Charges outside add zero net flux",
          "pattern": "outside[^.]{0,120}(zero|no) net|outside[^.]{0,80}add(s|ing)? (zero|nothing)|(zero|no) net (flux|contribution)[^.]{0,120}outside"
        }
      ]
    },
    {
      "topic": "electric-potential",
      "chapter": "electrostatics",
      "facts": [
        {
          "id": "point-charge",
          "claim": "V = kq/r for a point charge",
          "pattern": "v\\s*=\\s*(frac\\s*)?k\\s*q\\s*/?\\s*r|v\\s*=\\s*frac\\s*q\\s*4\\s*pi|kq\\s*/\\s*r"
        },
        { "id": "unit", "claim": "Volt = joule per coulomb", "pattern": "j/c|joules? per coulomb" },
        { "id": "scalar", "claim": "Potential is a scalar", "pattern": "scalar" }
      ]
    },
    {
      "topic": "capacitors",
      "chapter": "capacitance",
      "facts": [
        {
          "id": "definition",
          "claim": "C = Q/V",
          "pattern": "c\\s*=\\s*frac\\s*q\\s*v|c\\s*=\\s*q\\s*/\\s*v|charge (stored )?per (unit )?(volt|potential difference)"
        },
        { "id": "farad", "claim": "Unit is the farad", "pattern": "farad" },
        {
          "id": "parallel-plate",
          "claim": "Parallel plates: C = ε₀A/d",
          "pattern": "frac\\s*(kappa\\s*)?(var)?epsilon_?0\\s*a\\s*d|(var)?epsilon_?0\\s*a\\s*/\\s*d"
        }
      ]
    },
    {
      "topic": "capacitor-energy",
      "chapter": "capacitance",
      "facts": [
        {
          "id": "half-cv2",
          "claim": "U = ½CV²",
          "pattern": "frac\\s*1\\s*2\\s*c\\s*v\\^2|1\\s*/\\s*2\\s*c\\s*v\\^2|½\\s*c\\s*v\\^?2|half[^.]{0,20}c\\s*v\\s*squared"
        },
        {
          "id": "in-field",
          "claim": "Energy is stored in the electric field",
          "pattern": "stored in the (electric )?field|energy density"
        },
        {
          "id": "alt-forms",
          "claim": "Also U = Q²/2C = ½QV",
          "pattern": "frac\\s*q\\^2\\s*2\\s*c|q\\^2\\s*/\\s*\\(?2\\s*c|frac\\s*1\\s*2\\s*q\\s*v|1\\s*/\\s*2\\s*q\\s*v"
        }
      ]
    },
    {
      "topic": "ohms-law",
      "chapter": "current-electricity",
      "facts": [
        { "id": "v-ir", "claim": "V = IR", "pattern": "v\\s*=\\s*i\\s*r\\b" },
        {
          "id": "resistivity",
          "claim": "R = ρL/A",
          "pattern": "frac\\s*rho\\s*(l|ell)\\s*a|rho\\s*(l|ell)\\s*/\\s*a|resistivity"
        },
        { "id": "ohm", "claim": "Resistance in ohms", "pattern": "ohm|ω" }
      ]
    },
    {
      "topic": "kirchhoffs-laws",
      "chapter": "current-electricity",
      "facts": [
        {
          "id": "charge",
          "claim": "Junction rule comes from conservation of charge",
          "pattern": "conservation of (electric )?charge|charge is conserved"
        },
        {
          "id": "energy",
          "claim": "Loop rule comes from conservation of energy",
          "pattern": "conservation of energy|energy is conserved"
        },
        {
          "id": "rules",
          "claim": "Junction and loop rules",
          "pattern": "junction[^.]{0,400}loop|loop[^.]{0,400}junction"
        }
      ]
    },
    {
      "topic": "rc-circuits",
      "chapter": "current-electricity",
      "facts": [
        {
          "id": "tau",
          "claim": "Time constant τ = RC",
          "pattern": "tau\\s*=\\s*r\\s*c|τ\\s*=\\s*rc|time constant"
        },
        {
          "id": "63",
          "claim": "After one time constant a charging capacitor reaches about 63%",
          "pattern": "63"
        },
        {
          "id": "exponential",
          "claim": "Charge/current change exponentially",
          "pattern": "exponential|e\\^\\s*-\\s*t"
        }
      ]
    },
    {
      "topic": "biot-savart-law",
      "chapter": "magnetostatics",
      "facts": [
        {
          "id": "inverse-square",
          "claim": "dB falls as 1/r²",
          "pattern": "r\\^2|inverse[- ]square"
        },
        {
          "id": "mu0",
          "claim": "Uses the permeability of free space μ₀",
          "pattern": "mu_?0|μ_?0|permeability"
        },
        {
          "id": "straight-wire",
          "claim": "Long straight wire: B = μ₀I/2πr",
          "pattern": "frac\\s*mu_?0\\s*i\\s*2\\s*pi\\s*r|mu_?0\\s*i\\s*/\\s*\\(?2\\s*pi\\s*r|2\\s*pi\\s*r"
        }
      ]
    },
    {
      "topic": "amperes-law",
      "chapter": "magnetostatics",
      "facts": [
        {
          "id": "statement",
          "claim": "∮B·dl = μ₀I_enc around a closed loop",
          "pattern": "oint|closed (loop|path|curve)"
        },
        {
          "id": "solenoid",
          "claim": "Solenoid: B = μ₀nI",
          "pattern": "mu_?0\\s*n\\s*i|turns per (unit )?length"
        },
        { "id": "symmetry", "claim": "Useful when there is symmetry", "pattern": "symmetr" }
      ]
    },
    {
      "topic": "faradays-law",
      "chapter": "induction",
      "facts": [
        {
          "id": "rate",
          "claim": "EMF = −dΦ/dt (rate of change of flux)",
          "pattern": "fracd\\s*(phi|φ)|d\\s*(phi|φ)_?(b|textb|mathrmb)?\\s*/\\s*d\\s*t|rate of change of (the )?(magnetic )?flux"
        },
        { "id": "turns", "claim": "N turns multiply the EMF", "pattern": "turns|coil" },
        {
          "id": "weber",
          "claim": "Flux measured in webers",
          "pattern": "weber|\\bwb\\b|t\\s*·?\\s*m\\^2"
        }
      ]
    },
    {
      "topic": "lenzs-law",
      "chapter": "induction",
      "facts": [
        {
          "id": "opposes",
          "claim": "Induced current opposes the change in flux",
          "pattern": "oppos"
        },
        {
          "id": "energy",
          "claim": "Follows from conservation of energy",
          "pattern": "conservation of energy|energy is conserved"
        },
        {
          "id": "minus-sign",
          "claim": "It is the minus sign in Faraday's law",
          "pattern": "minus sign|negative sign"
        }
      ]
    },
    {
      "topic": "ac-rms",
      "chapter": "alternating-current",
      "facts": [
        {
          "id": "root-two",
          "claim": "V_rms = V₀/√2 ≈ 0.707 V₀",
          "pattern": "sqrt\\s*2|√2|0\\.707"
        },
        {
          "id": "average-zero",
          "claim": "Average over a full cycle is zero",
          "pattern": "average[^.]{0,80}(zero|0)\\b|(zero|0) average"
        },
        {
          "id": "heating",
          "claim": "RMS gives the same heating as a steady DC value",
          "pattern": "same (heating|power|average power)|equivalent (dc|steady)|heating effect|dc (value|voltage|current) (that|which)"
        }
      ]
    },
    {
      "topic": "transformers",
      "chapter": "alternating-current",
      "facts": [
        {
          "id": "ratio",
          "claim": "Vs/Vp = Ns/Np",
          "pattern": "frac\\s*v_?s\\s*v_?p|frac\\s*n_?s\\s*n_?p|v_?s\\s*/\\s*v_?p|n_?s\\s*/\\s*n_?p|turns ratio"
        },
        {
          "id": "ac-only",
          "claim": "Needs AC (a changing flux)",
          "pattern": "alternating|\\bac\\b|changing (magnetic )?flux"
        },
        {
          "id": "step",
          "claim": "Step-up and step-down transformers",
          "pattern": "step[- ]up|step[- ]down"
        }
      ]
    }
  ]
}

{
  "id": "engg-graphics",
  "name": "Engineering Graphics & Design",
  "field": "Engineering Graphics",
  "tier": "tested",
  "branches": ["all"],
  "semesters": [1, 2],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree Courses in Engineering & Technology, Vol. I (Jan 2018): Engineering Graphics & Design (ESC102)",
    "url": "https://www.aicte.gov.in/sites/default/files/ug-vol1.pdf",
    "note": "Modules 1-8 of AICTE ESC102; sheet-wise scope (first-angle projection) from GCE Kalahandi's AICTE-model Engineering Graphics & Design (https://www.gcekjr.ac.in/pdf/news/2018/2758Proposed_First_Year_BTech_Syllabus_As_Per_AICTE_Model_Curriculum.pdf)."
  },
  "chapters": [
    {
      "id": "drawing-basics",
      "name": "Introduction to Engineering Drawing",
      "topics": [
        {
          "id": "drawing-instruments-conventions",
          "name": "Drawing instruments, lettering, line conventions and dimensioning (BIS)"
        },
        {
          "id": "scales",
          "name": "Scales: plain, diagonal and vernier",
          "requires": ["drawing-instruments-conventions"]
        },
        {
          "id": "conic-sections-drawing",
          "name": "Conic sections, including the rectangular hyperbola",
          "requires": ["drawing-instruments-conventions"]
        },
        {
          "id": "cycloids-involutes",
          "name": "Cycloid, epicycloid, hypocycloid and involute",
          "requires": ["drawing-instruments-conventions"]
        }
      ]
    },
    {
      "id": "orthographic-projection",
      "name": "Orthographic Projections",
      "topics": [
        {
          "id": "projection-principles",
          "name": "Principles of orthographic projection; first- and third-angle"
        },
        {
          "id": "projection-of-points",
          "name": "Projections of points in the four quadrants",
          "requires": ["projection-principles"]
        },
        {
          "id": "projection-of-lines",
          "name": "Projections of lines: true length and inclinations",
          "requires": ["projection-of-points"]
        },
        {
          "id": "projection-of-planes",
          "name": "Projections of planes; auxiliary planes",
          "requires": ["projection-of-lines"]
        }
      ]
    },
    {
      "id": "solids",
      "name": "Projections of Solids, Sections and Developments",
      "topics": [
        {
          "id": "projection-of-solids",
          "name": "Projections of prisms, pyramids, cylinders and cones"
        },
        {
          "id": "sections-of-solids",
          "name": "Sections and sectional views; true shape of a section",
          "requires": ["projection-of-solids"]
        },
        {
          "id": "development-of-surfaces",
          "name": "Development of lateral surfaces of solids",
          "requires": ["projection-of-solids"]
        }
      ]
    },
    {
      "id": "isometric",
      "name": "Isometric Projections",
      "topics": [
        {
          "id": "isometric-scale",
          "name": "Isometric scale and isometric views"
        },
        {
          "id": "isometric-solids",
          "name": "Isometric views of planes and simple and compound solids",
          "requires": ["isometric-scale"]
        },
        {
          "id": "isometric-to-orthographic",
          "name": "Converting isometric views to orthographic and back",
          "requires": ["isometric-solids"]
        }
      ]
    },
    {
      "id": "cad",
      "name": "Computer-Aided Drawing",
      "topics": [
        {
          "id": "cad-interface",
          "name": "CAD software: interface, coordinate systems and drawing commands"
        },
        {
          "id": "cad-editing-annotation",
          "name": "Editing, dimensioning, annotation and layers",
          "requires": ["cad-interface"]
        },
        {
          "id": "solid-modelling",
          "name": "Solid and surface modelling; building information modelling",
          "requires": ["cad-editing-annotation"]
        }
      ]
    }
  ]
}

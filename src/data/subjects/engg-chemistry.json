{
  "id": "engg-chemistry",
  "name": "Engineering Chemistry",
  "field": "Engineering Chemistry",
  "tier": "sourced",
  "branches": ["all"],
  "semesters": [1, 2],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree Courses in Engineering & Technology, Vol. I (Jan 2018): Chemistry-I (Concepts in chemistry for engineering)",
    "url": "https://www.aicte.gov.in/sites/default/files/ug-vol1.pdf",
    "note": "Atomic and molecular structure, spectroscopy, intermolecular forces, free energy and equilibria, periodic properties, stereochemistry and organic reactions follow AICTE Chemistry-I. Phase rule, fuels, corrosion and nanomaterials follow GCE Kalahandi's AICTE-model Chemistry-I (https://www.gcekjr.ac.in/pdf/news/2018/2758Proposed_First_Year_BTech_Syllabus_As_Per_AICTE_Model_Curriculum.pdf)."
  },
  "visualSet": "chemistry",
  "chapters": [
    {
      "id": "atomic-molecular-structure",
      "name": "Atomic and Molecular Structure",
      "hours": 12,
      "topics": [
        {
          "id": "schrodinger-particle-in-box-chem",
          "name": "Schrödinger equation and particle in a box (conjugated molecules, nanoparticles)"
        },
        {
          "id": "hydrogen-wave-functions",
          "name": "Hydrogen atom wave functions and orbitals",
          "requires": ["schrodinger-particle-in-box-chem"]
        },
        {
          "id": "molecular-orbital-theory",
          "name": "Molecular orbitals of diatomic molecules",
          "requires": ["hydrogen-wave-functions"]
        },
        {
          "id": "aromaticity-pi-orbitals",
          "name": "Pi-molecular orbitals of butadiene and benzene; aromaticity",
          "requires": ["molecular-orbital-theory"]
        },
        {
          "id": "crystal-field-theory",
          "name": "Crystal field theory and magnetic properties",
          "requires": ["hydrogen-wave-functions"]
        },
        {
          "id": "band-structure-doping",
          "name": "Band structure of solids and doping",
          "requires": ["molecular-orbital-theory"]
        }
      ]
    },
    {
      "id": "spectroscopy",
      "name": "Spectroscopic Techniques",
      "hours": 8,
      "topics": [
        {
          "id": "spectroscopy-principles",
          "name": "Principles of spectroscopy and selection rules; Beer-Lambert law"
        },
        {
          "id": "uv-visible-spectroscopy",
          "name": "Electronic (UV-visible) spectroscopy and chromophores",
          "requires": ["spectroscopy-principles"]
        },
        {
          "id": "fluorescence",
          "name": "Fluorescence and its applications in medicine",
          "requires": ["uv-visible-spectroscopy"]
        },
        {
          "id": "vibrational-rotational-spectroscopy",
          "name": "Vibrational and rotational spectroscopy of diatomic molecules",
          "requires": ["spectroscopy-principles"]
        },
        {
          "id": "nmr-mri",
          "name": "Nuclear magnetic resonance and MRI",
          "requires": ["spectroscopy-principles"]
        },
        {
          "id": "diffraction-surface-techniques",
          "name": "Diffraction, scattering and surface characterisation",
          "requires": ["spectroscopy-principles"]
        }
      ]
    },
    {
      "id": "intermolecular-forces",
      "name": "Intermolecular Forces and Real Gases",
      "hours": 4,
      "topics": [
        {
          "id": "intermolecular-interactions",
          "name": "Ionic, dipolar and van der Waals interactions"
        },
        {
          "id": "real-gases-critical",
          "name": "Equations of state of real gases and critical phenomena",
          "requires": ["intermolecular-interactions"]
        },
        {
          "id": "potential-energy-surfaces",
          "name": "Potential energy surfaces",
          "requires": ["intermolecular-interactions"]
        }
      ]
    },
    {
      "id": "free-energy-equilibria",
      "name": "Free Energy, Electrochemistry and Corrosion",
      "hours": 14,
      "topics": [
        {
          "id": "thermodynamic-functions",
          "name": "Energy, entropy and free energy"
        },
        {
          "id": "nernst-equation",
          "name": "Free energy and emf; cell potentials and the Nernst equation",
          "requires": ["thermodynamic-functions"]
        },
        {
          "id": "acid-base-redox-solubility",
          "name": "Acid-base, redox and solubility equilibria",
          "requires": ["thermodynamic-functions"]
        },
        {
          "id": "water-chemistry",
          "name": "Water chemistry: hardness and treatment",
          "requires": ["acid-base-redox-solubility"]
        },
        {
          "id": "ellingham-diagrams",
          "name": "Free energy in metallurgy: Ellingham diagrams",
          "requires": ["thermodynamic-functions"]
        },
        {
          "id": "electrochemical-corrosion",
          "name": "Electrochemical theory of corrosion and the galvanic series",
          "requires": ["nernst-equation"]
        },
        {
          "id": "types-of-corrosion",
          "name": "Types of corrosion: differential metal, differential aeration, stress corrosion",
          "requires": ["electrochemical-corrosion"]
        },
        {
          "id": "corrosion-protection",
          "name": "Corrosion control: coatings, inhibitors and cathodic protection",
          "requires": ["types-of-corrosion"]
        }
      ]
    },
    {
      "id": "periodic-properties",
      "name": "Periodic Properties",
      "hours": 4,
      "topics": [
        {
          "id": "effective-nuclear-charge",
          "name": "Effective nuclear charge, penetration and orbital energies"
        },
        {
          "id": "periodic-trends",
          "name": "Atomic and ionic sizes, ionisation energy, electron affinity, electronegativity",
          "requires": ["effective-nuclear-charge"]
        },
        {
          "id": "hsab-geometries",
          "name": "Oxidation states, coordination, HSAB and molecular geometries",
          "requires": ["periodic-trends"]
        }
      ]
    },
    {
      "id": "stereochemistry",
      "name": "Stereochemistry",
      "hours": 4,
      "topics": [
        {
          "id": "isomerism",
          "name": "Structural isomers and stereoisomers"
        },
        {
          "id": "chirality-optical-activity",
          "name": "Symmetry, chirality, enantiomers and optical activity",
          "requires": ["isomerism"]
        },
        {
          "id": "configurations-conformations",
          "name": "Absolute configurations and conformational analysis",
          "requires": ["chirality-optical-activity"]
        },
        {
          "id": "isomerism-coordination-compounds",
          "name": "Isomerism in transition metal compounds",
          "requires": ["isomerism"]
        }
      ]
    },
    {
      "id": "organic-reactions",
      "name": "Organic Reactions and Drug Synthesis",
      "hours": 4,
      "topics": [
        {
          "id": "substitution-addition-elimination",
          "name": "Substitution, addition and elimination reactions"
        },
        {
          "id": "oxidation-reduction-cyclisation",
          "name": "Oxidation, reduction, cyclisation and ring opening",
          "requires": ["substitution-addition-elimination"]
        },
        {
          "id": "drug-synthesis",
          "name": "Synthesis of a commonly used drug molecule (paracetamol, aspirin)",
          "requires": ["oxidation-reduction-cyclisation"]
        }
      ]
    },
    {
      "id": "phase-rule",
      "name": "Phase Rule",
      "hours": 8,
      "topics": [
        {
          "id": "gibbs-phase-rule",
          "name": "Gibbs' phase rule and its terms"
        },
        {
          "id": "one-component-systems",
          "name": "One-component systems: water and sulphur",
          "requires": ["gibbs-phase-rule"]
        },
        {
          "id": "two-component-eutectic",
          "name": "Two-component systems: eutectic (Pb-Sn, Bi-Cd) and isomorphous",
          "requires": ["one-component-systems"]
        }
      ]
    },
    {
      "id": "fuels",
      "name": "Fuels and Combustion",
      "hours": 10,
      "topics": [
        {
          "id": "fuel-classification-calorific-value",
          "name": "Classification of fuels and calorific value (Dulong's formula, GCV, NCV)"
        },
        {
          "id": "coal-analysis",
          "name": "Solid fuels: proximate and ultimate analysis of coal",
          "requires": ["fuel-classification-calorific-value"]
        },
        {
          "id": "petroleum-refining-cracking",
          "name": "Petroleum refining and cracking",
          "requires": ["fuel-classification-calorific-value"]
        },
        {
          "id": "knocking-octane-cetane",
          "name": "Knocking, octane and cetane numbers",
          "requires": ["petroleum-refining-cracking"]
        },
        {
          "id": "gaseous-fuels",
          "name": "Gaseous fuels: producer gas, water gas, LPG, CNG",
          "requires": ["fuel-classification-calorific-value"]
        },
        {
          "id": "combustion-calculations",
          "name": "Combustion calculations",
          "requires": ["fuel-classification-calorific-value"]
        }
      ]
    },
    {
      "id": "nanomaterials",
      "name": "New Materials: Nanomaterials",
      "hours": 10,
      "topics": [
        {
          "id": "nanomaterials-classification",
          "name": "Nanomaterials: 0D, 1D and 2D, and size-dependent properties"
        },
        {
          "id": "nanomaterial-synthesis",
          "name": "Top-down, bottom-up and green synthesis",
          "requires": ["nanomaterials-classification"]
        },
        {
          "id": "nanomaterial-applications",
          "name": "Applications in the environment and electronics",
          "requires": ["nanomaterial-synthesis"]
        }
      ]
    }
  ]
}

{
  "id": "dsa",
  "name": "Data Structures and Algorithms",
  "field": "Computer Science",
  "tier": "sourced",
  "branches": ["ce", "it", "ict", "ece"],
  "semesters": [3, 4],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Computer Science & Engineering (Jan 2018): PCC-CS301 Data Structure & Algorithms and PCC-CS404 Design and Analysis of Algorithms",
    "url": "https://www.iiitd.ac.in/sites/default/files/docs/about/AICTE2018-CSE-Curriculum.pdf",
    "note": "Data structures follow PCC-CS301; algorithm design, graph algorithms and NP-completeness follow PCC-CS404."
  },
  "visualSet": "computing",
  "chapters": [
    {
      "id": "ds-basics",
      "name": "Basics and Analysis",
      "hours": 8,
      "topics": [
        {
          "id": "asymptotic-notation",
          "name": "Asymptotic notation: big O, Omega and Theta"
        },
        {
          "id": "time-space-tradeoff",
          "name": "Best, average and worst case; time–space trade-off",
          "requires": ["asymptotic-notation"]
        },
        {
          "id": "recurrences-master-theorem",
          "name": "Recurrences and the master theorem",
          "requires": ["asymptotic-notation"]
        },
        {
          "id": "linear-binary-search",
          "name": "Linear and binary search and their complexity",
          "requires": ["asymptotic-notation"]
        }
      ]
    },
    {
      "id": "stacks-queues",
      "name": "Stacks and Queues",
      "hours": 6,
      "topics": [
        {
          "id": "stack-adt",
          "name": "The stack ADT and its operations"
        },
        {
          "id": "expression-conversion",
          "name": "Infix, postfix and prefix: conversion and evaluation",
          "requires": ["stack-adt"]
        },
        {
          "id": "queue-types",
          "name": "Queues: simple, circular, deque and priority queue",
          "requires": ["stack-adt"]
        }
      ]
    },
    {
      "id": "linked-lists",
      "name": "Linked Lists",
      "hours": 6,
      "topics": [
        {
          "id": "singly-linked-list",
          "name": "Singly linked lists: traversal, search, insertion, deletion"
        },
        {
          "id": "doubly-circular-lists",
          "name": "Doubly and circular linked lists",
          "requires": ["singly-linked-list"]
        },
        {
          "id": "linked-stack-queue",
          "name": "Linked representation of stacks and queues",
          "requires": ["singly-linked-list", "stack-adt"]
        }
      ]
    },
    {
      "id": "trees",
      "name": "Trees",
      "hours": 10,
      "topics": [
        {
          "id": "binary-tree-traversal",
          "name": "Binary trees and traversals (in-, pre-, post-order)"
        },
        {
          "id": "binary-search-tree",
          "name": "Binary search trees",
          "requires": ["binary-tree-traversal"]
        },
        {
          "id": "avl-tree",
          "name": "AVL trees and rotations",
          "requires": ["binary-search-tree"]
        },
        {
          "id": "b-trees",
          "name": "B-trees and B+ trees",
          "requires": ["binary-search-tree"]
        },
        {
          "id": "heap-structure",
          "name": "Binary heaps",
          "requires": ["binary-tree-traversal"]
        }
      ]
    },
    {
      "id": "sorting-hashing",
      "name": "Sorting and Hashing",
      "hours": 8,
      "topics": [
        {
          "id": "simple-sorts-dsa",
          "name": "Selection, bubble and insertion sort compared"
        },
        {
          "id": "merge-sort-dsa",
          "name": "Merge sort",
          "requires": ["simple-sorts-dsa"]
        },
        {
          "id": "quick-sort",
          "name": "Quicksort",
          "requires": ["simple-sorts-dsa"]
        },
        {
          "id": "heap-sort",
          "name": "Heap sort",
          "requires": ["heap-structure"]
        },
        {
          "id": "hashing",
          "name": "Hashing, hash functions and collision resolution",
          "requires": ["linear-binary-search"]
        }
      ]
    },
    {
      "id": "graphs-dsa",
      "name": "Graphs and Graph Algorithms",
      "hours": 8,
      "topics": [
        {
          "id": "graph-representation",
          "name": "Graph terminology and representations"
        },
        {
          "id": "bfs-dfs",
          "name": "Breadth-first and depth-first search",
          "requires": ["graph-representation"]
        },
        {
          "id": "shortest-paths",
          "name": "Shortest paths: Dijkstra and Bellman–Ford",
          "requires": ["bfs-dfs"]
        },
        {
          "id": "minimum-spanning-tree",
          "name": "Minimum spanning trees: Prim and Kruskal",
          "requires": ["graph-representation"]
        },
        {
          "id": "topological-sort",
          "name": "Topological sorting",
          "requires": ["bfs-dfs"]
        }
      ]
    },
    {
      "id": "algorithm-design",
      "name": "Algorithm Design Paradigms",
      "hours": 8,
      "topics": [
        {
          "id": "divide-and-conquer",
          "name": "Divide and conquer",
          "requires": ["recurrences-master-theorem"]
        },
        {
          "id": "greedy-algorithms",
          "name": "Greedy algorithms (fractional knapsack, activity selection)",
          "requires": ["asymptotic-notation"]
        },
        {
          "id": "dynamic-programming",
          "name": "Dynamic programming (0/1 knapsack, LCS)",
          "requires": ["divide-and-conquer"]
        },
        {
          "id": "backtracking-branch-bound",
          "name": "Backtracking and branch and bound",
          "requires": ["dynamic-programming"]
        }
      ]
    },
    {
      "id": "complexity-classes",
      "name": "Tractable and Intractable Problems",
      "hours": 6,
      "topics": [
        {
          "id": "p-np",
          "name": "P, NP, NP-complete and NP-hard",
          "requires": ["dynamic-programming"]
        },
        {
          "id": "reductions-cook",
          "name": "Reductions and Cook's theorem",
          "requires": ["p-np"]
        },
        {
          "id": "approximation-randomized",
          "name": "Approximation and randomized algorithms",
          "requires": ["p-np"]
        }
      ]
    }
  ]
}

{
  "id": "communication-systems",
  "name": "Communication Systems",
  "field": "Electronics Engineering",
  "tier": "sourced",
  "branches": ["ece", "ict"],
  "semesters": [4, 5],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Electronics & Communication Engineering (2018; copy hosted by Dibrugarh University): EC07 Analog and Digital Communication",
    "url": "https://oldweb.dibru.ac.in/wp-content/uploads/2020/12/ECE-Model-curriculum-2018-BATCH-ONWARDS_Modified.pdf",
    "note": "All units of EC07."
  },
  "visualSet": "signals",
  "chapters": [
    {
      "id": "amplitude-modulation",
      "name": "Amplitude Modulation",
      "hours": 6,
      "topics": [
        {
          "id": "am-dsb",
          "name": "AM and DSB-SC modulation"
        },
        {
          "id": "ssb-vsb",
          "name": "SSB and VSB modulation",
          "requires": ["am-dsb"]
        }
      ]
    },
    {
      "id": "angle-modulation",
      "name": "Angle Modulation",
      "hours": 6,
      "topics": [
        {
          "id": "fm-pm",
          "name": "Frequency and phase modulation",
          "requires": ["am-dsb"]
        },
        {
          "id": "fm-bandwidth",
          "name": "FM spectrum and Carson's rule",
          "requires": ["fm-pm"]
        }
      ]
    },
    {
      "id": "noise",
      "name": "Noise in Communication Systems",
      "hours": 6,
      "topics": [
        {
          "id": "noise-gaussian",
          "name": "Gaussian and white noise"
        },
        {
          "id": "snr-preemphasis",
          "name": "Noise in AM and FM; pre-emphasis and the threshold effect",
          "requires": ["noise-gaussian", "fm-pm"]
        }
      ]
    },
    {
      "id": "pulse-modulation",
      "name": "Pulse Modulation",
      "hours": 8,
      "topics": [
        {
          "id": "pam-pcm",
          "name": "Sampling, PAM and PCM; quantisation"
        },
        {
          "id": "dpcm-delta",
          "name": "DPCM and delta modulation",
          "requires": ["pam-pcm"]
        },
        {
          "id": "tdm-comm",
          "name": "Time-division multiplexing",
          "requires": ["pam-pcm"]
        }
      ]
    },
    {
      "id": "digital-modulation",
      "name": "Digital Communication",
      "hours": 10,
      "topics": [
        {
          "id": "matched-filter",
          "name": "Optimum detection and the matched filter; probability of error",
          "requires": ["noise-gaussian"]
        },
        {
          "id": "isi-nyquist",
          "name": "Intersymbol interference and the Nyquist criterion",
          "requires": ["pam-pcm"]
        },
        {
          "id": "psk-fsk-qam",
          "name": "ASK, FSK, PSK and QAM",
          "requires": ["matched-filter"]
        },
        {
          "id": "msk-equalisation",
          "name": "MSK, equalisation and synchronisation",
          "requires": ["psk-fsk-qam"]
        }
      ]
    }
  ]
}

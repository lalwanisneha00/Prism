{
  "id": "microprocessors",
  "name": "Microprocessors and Microcontrollers",
  "field": "Electronics Engineering",
  "tier": "sourced",
  "branches": ["ece", "ict", "ce"],
  "semesters": [5],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Electronics & Communication Engineering (2018; copy hosted by Dibrugarh University): EC11 Microcontrollers",
    "url": "https://oldweb.dibru.ac.in/wp-content/uploads/2020/12/ECE-Model-curriculum-2018-BATCH-ONWARDS_Modified.pdf",
    "note": "All units of EC11."
  },
  "visualSet": "computing",
  "chapters": [
    {
      "id": "microcomputer-basics",
      "name": "Microcomputer Systems",
      "hours": 8,
      "topics": [
        {
          "id": "microcomputer-blocks",
          "name": "Microcomputer building blocks and buses"
        },
        {
          "id": "memory-interfacing",
          "name": "Memory interfacing and address decoding",
          "requires": ["microcomputer-blocks"]
        },
        {
          "id": "interrupts-dma-mp",
          "name": "Interrupts and DMA",
          "requires": ["microcomputer-blocks"]
        }
      ]
    },
    {
      "id": "8085-8086",
      "name": "The 8085 and 8086",
      "hours": 10,
      "topics": [
        {
          "id": "intel-8085",
          "name": "8085 architecture and instruction set",
          "requires": ["microcomputer-blocks"]
        },
        {
          "id": "intel-8086",
          "name": "8086 architecture, segmentation and addressing modes",
          "requires": ["intel-8085"]
        },
        {
          "id": "assembly-programming",
          "name": "Assembly language programming",
          "requires": ["intel-8085"]
        }
      ]
    },
    {
      "id": "peripherals",
      "name": "Interfacing Peripherals",
      "hours": 8,
      "topics": [
        {
          "id": "timers-serial-parallel",
          "name": "Timers, serial and parallel I/O",
          "requires": ["memory-interfacing"]
        },
        {
          "id": "adc-dac-interfacing",
          "name": "Interfacing ADCs and DACs",
          "requires": ["timers-serial-parallel"]
        },
        {
          "id": "coprocessors",
          "name": "Arithmetic coprocessors",
          "requires": ["intel-8086"]
        }
      ]
    },
    {
      "id": "advanced-processors",
      "name": "Advanced Processors",
      "hours": 6,
      "topics": [
        {
          "id": "cache-virtual-memory-mp",
          "name": "Virtual memory and cache in 286, 486 and Pentium",
          "requires": ["intel-8086"]
        },
        {
          "id": "risc",
          "name": "RISC processors",
          "requires": ["intel-8086"]
        }
      ]
    },
    {
      "id": "microcontrollers",
      "name": "Microcontrollers",
      "hours": 8,
      "topics": [
        {
          "id": "intel-8051",
          "name": "The 8051 microcontroller",
          "requires": ["microcomputer-blocks"]
        },
        {
          "id": "arm-microcontrollers",
          "name": "ARM microcontrollers and interfacing",
          "requires": ["risc", "intel-8051"]
        }
      ]
    }
  ]
}

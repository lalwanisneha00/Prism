{
  "id": "machine-design",
  "name": "Design of Machine Elements",
  "field": "Mechanical Engineering",
  "tier": "sourced",
  "branches": ["me"],
  "semesters": [5],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE revised Model Curriculum for UG Degree Course in Mechanical Engineering: PCC-ME 301 Machine Element & System Design",
    "url": "https://www.aicte.gov.in/sites/default/files/Final_Mechanical%20Engg.pdf",
    "note": "Modules I–IV of PCC-ME 301 (vibrations are in Theory of Machines)."
  },
  "visualSet": "mechanics",
  "chapters": [
    {
      "id": "design-basics",
      "name": "Design Basics",
      "hours": 6,
      "topics": [
        {
          "id": "limits-fits-tolerances",
          "name": "Limits, fits and standardisation"
        },
        {
          "id": "friction-lubrication-design",
          "name": "Friction and lubrication in machine elements"
        },
        {
          "id": "power-screws",
          "name": "Power screws, couplings, clutches and brakes",
          "requires": ["friction-lubrication-design"]
        }
      ]
    },
    {
      "id": "failure",
      "name": "Failure Theories and Fatigue",
      "hours": 8,
      "topics": [
        {
          "id": "static-failure-theories",
          "name": "Static failure theories: maximum normal stress, maximum shear stress, von Mises",
          "requires": ["limits-fits-tolerances"]
        },
        {
          "id": "factor-of-safety-concentration",
          "name": "Factor of safety and stress concentration",
          "requires": ["static-failure-theories"]
        },
        {
          "id": "fatigue-goodman-soderberg",
          "name": "Fatigue: endurance limit, Goodman, Gerber and Soderberg lines",
          "requires": ["factor-of-safety-concentration"]
        }
      ]
    },
    {
      "id": "elements",
      "name": "Design of Machine Elements",
      "hours": 14,
      "topics": [
        {
          "id": "shaft-design",
          "name": "Shafts under static and fatigue loading; keys",
          "requires": ["fatigue-goodman-soderberg"]
        },
        {
          "id": "springs-design",
          "name": "Helical and leaf springs",
          "requires": ["static-failure-theories"]
        },
        {
          "id": "bolted-riveted-welded",
          "name": "Threaded fasteners, bolted, riveted and welded joints",
          "requires": ["static-failure-theories"]
        },
        {
          "id": "bearings-design",
          "name": "Sliding and rolling contact bearings",
          "requires": ["friction-lubrication-design"]
        },
        {
          "id": "gear-design",
          "name": "Spur, helical, bevel and worm gear drives",
          "requires": ["static-failure-theories"]
        },
        {
          "id": "belt-chain-drives",
          "name": "Belt and chain drives; flywheels",
          "requires": ["friction-lubrication-design"]
        }
      ]
    }
  ]
}

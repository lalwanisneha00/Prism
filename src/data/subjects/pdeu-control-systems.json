  "chapters": [
    {
      "id": "introduction-and-mathematical-modelling-of-linear",
      "name": "Introduction and Mathematical Modelling of Linear Control Systems",
      "hours": 10,
      "topics": [
        {
          "id": "introduction-to-linear-and-non-linear-control-systems-notion",
          "name": "Introduction to Linear and Non-linear control systems, Notion of feedback, Open-loop and closed-loop control systems, Examples of Control Systems, Design and Compensation of Control Systems"
        },
        {
          "id": "block-diagram-and-signal-flow-graphs-representations-and",
          "name": "Block diagram and signal-flow graphs representations and simplifications",
          "requires": ["introduction-to-linear-and-non-linear-control-systems-notion"]
        },
        {
          "id": "mathematical-modelling-and-analogy-differential-equations",
          "name": "Mathematical modelling and analogy, Differential equations, Transfer Function and Impulse-Response Function, Systems with transport lag, Linearization",
          "requires": ["block-diagram-and-signal-flow-graphs-representations-and"]
        }
      ]
    },
    {
      "id": "time-domain-performance-and-stability-analysis",
      "name": "Time Domain Performance and Stability Analysis",
      "hours": 12,
      "topics": [
        {
          "id": "time-response",
          "name": "Time response"
        },
        {
          "id": "transient-response",
          "name": "Transient response",
          "requires": ["time-response"]
        },
        {
          "id": "steady-state-response",
          "name": "Steady-state response",
          "requires": ["transient-response"]
        },
        {
          "id": "responses-of-first-and-second-order-systems-to-standard-test",
          "name": "Responses of first- and second-order systems to standard test signals and related specifications",
          "requires": ["steady-state-response"]
        },
        {
          "id": "stability-definition-and-meaning",
          "name": "Stability definition and meaning",
          "requires": ["responses-of-first-and-second-order-systems-to-standard-test"]
        },
        {
          "id": "routh-hurwitz",
          "name": "Routh-Hurwitz stability criterion",
          "requires": ["stability-definition-and-meaning"]
        },
        {
          "id": "root-locus",
          "name": "Analysis of control systems using root locus plots",
          "requires": ["routh-hurwitz"]
        }
      ]
    },
    {
      "id": "frequency-domain-analysis-and-design",
      "name": "Frequency Domain Analysis and Design",
      "hours": 12,
      "topics": [
        {
          "id": "nyquist-stability-criterion",
          "name": "Nyquist stability criterion"
        },
        {
          "id": "bode-plots-control",
          "name": "Gain and Phase margins, Bode plots, Frequency domain specifications and their correlations with time response, Design and performance goals",
          "requires": ["nyquist-stability-criterion"]
        },
        {
          "id": "steady-state-transient-and-robustness-specifications",
          "name": "Steady-state, transient and robustness specifications, Introduction to P, PD, PI and PID controllers and their design, Introduction to Lag and Lead compensator design, Analogy with electronic systems ",
          "requires": ["bode-plots-control"]
        }
      ]
    },
    {
      "id": "introduction-to-state-space-analysis-and-way",
      "name": "Introduction to State Space Analysis and Way Forward",
      "hours": 8,
      "topics": [
        {
          "id": "modelling-in-state-space",
          "name": "Modelling in State Space"
        },
        {
          "id": "state-space",
          "name": "State-Space Representation and Analysis",
          "requires": ["modelling-in-state-space"]
        },
        {
          "id": "canonical-state-variable-model",
          "name": "Canonical state variable model",
          "requires": ["state-space"]
        },
        {
          "id": "equivalence-to-transfer-function-model-and-conversions",
          "name": "Equivalence to transfer function model and conversions",
          "requires": ["canonical-state-variable-model"]
        },
        {
          "id": "solution-of-state-equations",
          "name": "Solution of state equations",
          "requires": ["equivalence-to-transfer-function-model-and-conversions"]
        },
        {
          "id": "concepts-of-controllability-and-observability",
          "name": "Concepts of Controllability and Observability",
          "requires": ["solution-of-state-equations"]
        },
        {
          "id": "introduction-to-modern-control-systems-and-way-forward",
          "name": "Introduction to modern control systems, and way forward",
          "requires": ["concepts-of-controllability-and-observability"]
        }
      ]
    }
  ]

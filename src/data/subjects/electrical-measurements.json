{
  "id": "electrical-measurements",
  "name": "Electrical Measurements and Instrumentation",
  "field": "Electrical Engineering",
  "tier": "sourced",
  "branches": ["ee", "ic"],
  "semesters": [6],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Electrical Engineering: PC301 Measurements and Instrumentation",
    "url": "https://www.aicte.gov.in/downloads/msyllabus/UG/ELECTRICAL%20Engg%20Final.pdf",
    "note": "All seven units of PC301."
  },
  "visualSet": "circuits",
  "chapters": [
    {
      "id": "measurement-basics",
      "name": "Measurement Basics and Errors",
      "hours": 6,
      "topics": [
        {
          "id": "measurement-characteristics",
          "name": "Accuracy, precision, resolution and calibration"
        },
        {
          "id": "measurement-errors",
          "name": "Types of errors and their compensation",
          "requires": ["measurement-characteristics"]
        },
        {
          "id": "galvanometer-pmmc",
          "name": "Galvanometers and PMMC instruments",
          "requires": ["measurement-characteristics"]
        }
      ]
    },
    {
      "id": "v-i-measurement",
      "name": "Voltage, Current and Resistance Measurement",
      "hours": 10,
      "topics": [
        {
          "id": "ammeter-voltmeter-extension",
          "name": "Ammeters and voltmeters: shunts and multipliers",
          "requires": ["galvanometer-pmmc"]
        },
        {
          "id": "moving-iron-instruments",
          "name": "Moving-iron instruments",
          "requires": ["ammeter-voltmeter-extension"]
        },
        {
          "id": "wheatstone-bridge-measure",
          "name": "Bridges for resistance measurement: Wheatstone and Kelvin",
          "requires": ["measurement-errors"]
        },
        {
          "id": "ac-bridges",
          "name": "AC bridges: Maxwell, Hay and Schering",
          "requires": ["wheatstone-bridge-measure"]
        }
      ]
    },
    {
      "id": "power-energy",
      "name": "Power and Energy Measurement",
      "hours": 6,
      "topics": [
        {
          "id": "electrodynamometer-wattmeter",
          "name": "Electrodynamometer wattmeter and its errors; LPF wattmeter",
          "requires": ["ammeter-voltmeter-extension"]
        },
        {
          "id": "energy-meter",
          "name": "Induction-type energy meter and its calibration",
          "requires": ["electrodynamometer-wattmeter"]
        }
      ]
    },
    {
      "id": "potentiometers-it",
      "name": "Potentiometers and Instrument Transformers",
      "hours": 6,
      "topics": [
        {
          "id": "dc-ac-potentiometer",
          "name": "DC and AC potentiometers",
          "requires": ["measurement-errors"]
        },
        {
          "id": "ct-vt",
          "name": "Current and voltage transformers: ratio and phase-angle errors",
          "requires": ["electrodynamometer-wattmeter"]
        }
      ]
    },
    {
      "id": "digital-instrumentation",
      "name": "Digital Instrumentation",
      "hours": 8,
      "topics": [
        {
          "id": "adc-measurement",
          "name": "ADCs for measurement: ramp, dual-slope and delta-modulation types",
          "requires": ["measurement-errors"]
        },
        {
          "id": "digital-multimeter-dso",
          "name": "Digital multimeters and the digital storage oscilloscope",
          "requires": ["adc-measurement"]
        },
        {
          "id": "transducers-intro",
          "name": "Transducers and sensors: strain gauge, LVDT, thermocouple",
          "requires": ["measurement-characteristics"]
        }
      ]
    }
  ]
}

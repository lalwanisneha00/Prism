{
  "id": "network-theory",
  "name": "Network Theory",
  "field": "Electrical Engineering",
  "tier": "sourced",
  "branches": ["ece", "ee", "ict"],
  "semesters": [3],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Electronics & Communication Engineering (2018; copy hosted by Dibrugarh University): EC06 Network Theory",
    "url": "https://oldweb.dibru.ac.in/wp-content/uploads/2020/12/ECE-Model-curriculum-2018-BATCH-ONWARDS_Modified.pdf",
    "note": "All units of EC06. Electrical Engineering's Circuit Theory is this subject (SPEC §12.1)."
  },
  "visualSet": "circuits",
  "chapters": [
    {
      "id": "network-analysis",
      "name": "Network Analysis",
      "hours": 6,
      "topics": [
        {
          "id": "nodal-mesh-matrix",
          "name": "Node and mesh analysis; matrix approach"
        },
        {
          "id": "source-transformation",
          "name": "Source transformation and duality",
          "requires": ["nodal-mesh-matrix"]
        }
      ]
    },
    {
      "id": "network-theorems",
      "name": "Network Theorems",
      "hours": 8,
      "topics": [
        {
          "id": "thevenin-norton-ac",
          "name": "Thevenin and Norton theorems for AC circuits",
          "requires": ["nodal-mesh-matrix"]
        },
        {
          "id": "max-power-transfer",
          "name": "Maximum power transfer theorem",
          "requires": ["thevenin-norton-ac"]
        },
        {
          "id": "reciprocity-tellegen",
          "name": "Reciprocity, compensation and Tellegen's theorem",
          "requires": ["nodal-mesh-matrix"]
        }
      ]
    },
    {
      "id": "fourier-nonsinusoidal",
      "name": "Non-sinusoidal Inputs",
      "hours": 6,
      "topics": [
        {
          "id": "fourier-network-response",
          "name": "Fourier series and steady-state response to periodic inputs",
          "requires": ["nodal-mesh-matrix"]
        },
        {
          "id": "unbalanced-three-phase",
          "name": "Unbalanced three-phase circuits and power",
          "requires": ["nodal-mesh-matrix"]
        }
      ]
    },
    {
      "id": "laplace-transients",
      "name": "Laplace Transform Analysis and Transients",
      "hours": 8,
      "topics": [
        {
          "id": "laplace-circuits",
          "name": "Laplace analysis of RC, RL and RLC networks",
          "requires": ["nodal-mesh-matrix"]
        },
        {
          "id": "initial-conditions",
          "name": "Initial conditions and singularity functions",
          "requires": ["laplace-circuits"]
        },
        {
          "id": "transfer-functions",
          "name": "Driving-point and transfer functions; poles and zeros",
          "requires": ["laplace-circuits"]
        }
      ]
    },
    {
      "id": "two-port-resonance",
      "name": "Two-port Networks, Resonance and Filters",
      "hours": 8,
      "topics": [
        {
          "id": "two-port-parameters",
          "name": "Two-port parameters (Z, Y, h, ABCD) and interconnections",
          "requires": ["nodal-mesh-matrix"]
        },
        {
          "id": "series-parallel-resonance",
          "name": "Series and parallel resonance; Q factor and bandwidth",
          "requires": ["laplace-circuits"]
        },
        {
          "id": "passive-filters",
          "name": "Low-pass, high-pass, band-pass and band-stop filters",
          "requires": ["series-parallel-resonance"]
        }
      ]
    }
  ]
}

{
  "id": "heat-transfer",
  "name": "Heat Transfer",
  "field": "Mechanical Engineering",
  "tier": "sourced",
  "branches": ["me", "chem", "auto", "aero"],
  "semesters": [4],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE revised Model Curriculum for UG Degree Course in Mechanical Engineering: PCC-ME 201 Heat Transfer & Thermal Machines",
    "url": "https://www.aicte.gov.in/sites/default/files/Final_Mechanical%20Engg.pdf",
    "note": "Modules I–VII of PCC-ME 201. Shared with Chemical Engineering (SPEC §12.2)."
  },
  "visualSet": "thermal",
  "chapters": [
    {
      "id": "ht-intro",
      "name": "Modes of Heat Transfer",
      "hours": 2,
      "topics": [
        {
          "id": "heat-transfer-modes",
          "name": "Conduction, convection and radiation; the heat balance"
        }
      ]
    },
    {
      "id": "conduction",
      "name": "Conduction",
      "hours": 10,
      "topics": [
        {
          "id": "fourier-law-1d",
          "name": "Fourier's law and steady 1D conduction in slabs, cylinders and spheres",
          "requires": ["heat-transfer-modes"]
        },
        {
          "id": "thermal-resistance-network",
          "name": "Thermal resistance networks and critical insulation thickness",
          "requires": ["fourier-law-1d"]
        },
        {
          "id": "fins",
          "name": "Heat transfer from pin fins: efficiency and effectiveness",
          "requires": ["fourier-law-1d"]
        },
        {
          "id": "lumped-biot",
          "name": "Transient conduction: lumped systems and the Biot number",
          "requires": ["fourier-law-1d"]
        }
      ]
    },
    {
      "id": "convection",
      "name": "Convection",
      "hours": 8,
      "topics": [
        {
          "id": "boundary-layers-ht",
          "name": "Velocity and thermal boundary layers",
          "requires": ["heat-transfer-modes"]
        },
        {
          "id": "forced-convection",
          "name": "Forced convection: Reynolds, Prandtl and Nusselt numbers",
          "requires": ["boundary-layers-ht"]
        },
        {
          "id": "natural-convection",
          "name": "Natural convection and the Grashof number",
          "requires": ["boundary-layers-ht"]
        }
      ]
    },
    {
      "id": "radiation-ht",
      "name": "Radiation",
      "hours": 6,
      "topics": [
        {
          "id": "blackbody-stefan",
          "name": "Black and grey bodies, emissivity and the Stefan–Boltzmann law",
          "requires": ["heat-transfer-modes"]
        },
        {
          "id": "view-factor-radiosity",
          "name": "View factors, radiosity and radiation shields",
          "requires": ["blackbody-stefan"]
        }
      ]
    },
    {
      "id": "exchangers-phase-change",
      "name": "Heat Exchangers, Boiling and Mass Transfer",
      "hours": 10,
      "topics": [
        {
          "id": "lmtd-method",
          "name": "Heat exchanger types and the LMTD method",
          "requires": ["forced-convection"]
        },
        {
          "id": "ntu-effectiveness",
          "name": "Effectiveness–NTU method",
          "requires": ["lmtd-method"]
        },
        {
          "id": "boiling-condensation",
          "name": "Pool boiling and film and dropwise condensation",
          "requires": ["forced-convection"]
        },
        {
          "id": "fick-mass-diffusion",
          "name": "Mass diffusion and Fick's law; heat–mass analogy",
          "requires": ["fourier-law-1d"]
        }
      ]
    }
  ]
}

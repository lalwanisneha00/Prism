{
  "id": "electrical-machines",
  "name": "Electrical Machines",
  "field": "Electrical Engineering",
  "tier": "sourced",
  "branches": ["ee"],
  "semesters": [3, 4],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Electrical Engineering: PCC204 Electrical Machines-I",
    "url": "https://www.aicte.gov.in/downloads/msyllabus/UG/ELECTRICAL%20Engg%20Final.pdf",
    "note": "All units of PCC204 (magnetic circuits, transformers, induction, single-phase, DC and synchronous machines)."
  },
  "visualSet": "circuits",
  "chapters": [
    {
      "id": "machine-fundamentals",
      "name": "Magnetic Circuits and Energy Conversion",
      "hours": 4,
      "topics": [
        {
          "id": "magnetic-circuits",
          "name": "Magnetic circuits: reluctance, permeance and B–H curves"
        },
        {
          "id": "emf-induction-machines",
          "name": "Faraday's law, Lenz's law and Fleming's rules in machines",
          "requires": ["magnetic-circuits"]
        }
      ]
    },
    {
      "id": "transformers-em",
      "name": "Transformers",
      "hours": 10,
      "topics": [
        {
          "id": "transformer-phasors-regulation",
          "name": "Transformer phasor diagrams, regulation and per-unit values",
          "requires": ["emf-induction-machines"]
        },
        {
          "id": "oc-sc-tests",
          "name": "Open-circuit and short-circuit tests; Sumpner test",
          "requires": ["transformer-phasors-regulation"]
        },
        {
          "id": "all-day-efficiency",
          "name": "Losses, efficiency and all-day efficiency",
          "requires": ["oc-sc-tests"]
        },
        {
          "id": "three-phase-transformer-groups",
          "name": "Three-phase transformers, vector groups and parallel operation",
          "requires": ["transformer-phasors-regulation"]
        },
        {
          "id": "autotransformer",
          "name": "Autotransformer and comparison with two-winding transformer",
          "requires": ["transformer-phasors-regulation"]
        }
      ]
    },
    {
      "id": "induction-machines",
      "name": "Induction Machines",
      "hours": 12,
      "topics": [
        {
          "id": "rotating-field-winding",
          "name": "Rotating magnetic field from a three-phase winding",
          "requires": ["emf-induction-machines"]
        },
        {
          "id": "slip-equivalent-circuit",
          "name": "Slip, equivalent circuit and power flow of the induction motor",
          "requires": ["rotating-field-winding"]
        },
        {
          "id": "torque-slip-characteristic",
          "name": "Torque equation and torque–slip characteristic",
          "requires": ["slip-equivalent-circuit"]
        },
        {
          "id": "induction-motor-tests-braking",
          "name": "No-load and blocked-rotor tests; starting, speed control and braking",
          "requires": ["torque-slip-characteristic"]
        },
        {
          "id": "single-phase-motors-em",
          "name": "Single-phase induction motors: double revolving field, capacitor start",
          "requires": ["rotating-field-winding"]
        },
        {
          "id": "universal-motor",
          "name": "Universal series motor",
          "requires": ["single-phase-motors-em"]
        }
      ]
    },
    {
      "id": "dc-machines-em",
      "name": "DC Machines",
      "hours": 8,
      "topics": [
        {
          "id": "dc-armature-windings-emf",
          "name": "DC machine construction, lap and wave windings, EMF and torque equations",
          "requires": ["emf-induction-machines"]
        },
        {
          "id": "dc-generator-characteristics",
          "name": "DC generator types and characteristics",
          "requires": ["dc-armature-windings-emf"]
        },
        {
          "id": "dc-motor-speed-control",
          "name": "DC motor characteristics, starting and speed control",
          "requires": ["dc-armature-windings-emf"]
        }
      ]
    },
    {
      "id": "synchronous-machines",
      "name": "Synchronous Machines",
      "hours": 8,
      "topics": [
        {
          "id": "alternator-phasors-excitation",
          "name": "Synchronous generators on the bus: phasors, under- and over-excitation",
          "requires": ["rotating-field-winding"]
        },
        {
          "id": "synchronous-motor-v-curves",
          "name": "Synchronous motor: V-curves, starting and power factor correction",
          "requires": ["alternator-phasors-excitation"]
        },
        {
          "id": "salient-pole-reactances",
          "name": "Salient-pole machines and synchronous reactances",
          "requires": ["alternator-phasors-excitation"]
        }
      ]
    }
  ]
}

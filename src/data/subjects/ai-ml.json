{
  "id": "ai-ml",
  "name": "Artificial Intelligence and Machine Learning",
  "field": "Computer Science",
  "tier": "sourced",
  "branches": ["ce", "ict"],
  "semesters": [5, 6],
  "syllabusSource": {
    "kind": "university",
    "title": "AKTU (AICTE model curriculum) B.Tech 3rd year CSE (AI & ML), 2022-23: KAI501 Artificial Intelligence and KAI601 Machine Learning Techniques",
    "url": "https://aktu.ac.in/pdf/syllabus/syllabus2223/B.Tech._3rd_Yr_CSE(AIML)_2022_23_revised_.pdf",
    "note": "AI units I–III and ML units I–V, combined as 'AI and ML basics' (SPEC §12.1)."
  },
  "visualSet": "computing",
  "chapters": [
    {
      "id": "ai-intro",
      "name": "Introduction to AI and Intelligent Agents",
      "hours": 6,
      "topics": [
        {
          "id": "ai-definition",
          "name": "What AI is; its history and future"
        },
        {
          "id": "intelligent-agents",
          "name": "Intelligent agents and environments",
          "requires": ["ai-definition"]
        }
      ]
    },
    {
      "id": "search",
      "name": "Problem Solving by Search",
      "hours": 8,
      "topics": [
        {
          "id": "uninformed-search",
          "name": "Uninformed search: BFS, DFS, uniform cost",
          "requires": ["intelligent-agents"]
        },
        {
          "id": "informed-search",
          "name": "Informed search: heuristics, greedy best-first and A*",
          "requires": ["uninformed-search"]
        },
        {
          "id": "local-search",
          "name": "Local search: hill climbing and simulated annealing",
          "requires": ["informed-search"]
        },
        {
          "id": "csp",
          "name": "Constraint satisfaction problems and backtracking",
          "requires": ["uninformed-search"]
        },
        {
          "id": "minimax-alpha-beta",
          "name": "Game playing: minimax and alpha–beta pruning",
          "requires": ["uninformed-search"]
        }
      ]
    },
    {
      "id": "knowledge-representation",
      "name": "Knowledge Representation and Reasoning",
      "hours": 6,
      "topics": [
        {
          "id": "first-order-logic",
          "name": "First-order predicate logic",
          "requires": ["ai-definition"]
        },
        {
          "id": "unification-resolution",
          "name": "Unification and resolution",
          "requires": ["first-order-logic"]
        },
        {
          "id": "forward-backward-chaining",
          "name": "Forward and backward chaining",
          "requires": ["first-order-logic"]
        }
      ]
    },
    {
      "id": "ml-intro",
      "name": "Introduction to Machine Learning",
      "hours": 6,
      "topics": [
        {
          "id": "types-of-learning",
          "name": "Supervised, unsupervised and reinforcement learning",
          "requires": ["ai-definition"]
        },
        {
          "id": "overfitting-validation",
          "name": "Training, testing, overfitting and cross-validation",
          "requires": ["types-of-learning"]
        }
      ]
    },
    {
      "id": "regression-bayes-svm",
      "name": "Regression, Bayesian Learning and SVMs",
      "hours": 8,
      "topics": [
        {
          "id": "linear-regression-ml",
          "name": "Linear regression",
          "requires": ["types-of-learning"]
        },
        {
          "id": "logistic-regression",
          "name": "Logistic regression",
          "requires": ["linear-regression-ml"]
        },
        {
          "id": "naive-bayes",
          "name": "Bayes' theorem and the naive Bayes classifier",
          "requires": ["types-of-learning"]
        },
        {
          "id": "svm",
          "name": "Support vector machines and kernels",
          "requires": ["logistic-regression"]
        }
      ]
    },
    {
      "id": "trees-instance",
      "name": "Decision Trees and Instance-based Learning",
      "hours": 8,
      "topics": [
        {
          "id": "decision-trees-id3",
          "name": "Decision trees, entropy, information gain and ID3",
          "requires": ["types-of-learning"]
        },
        {
          "id": "knn",
          "name": "k-nearest neighbours",
          "requires": ["types-of-learning"]
        },
        {
          "id": "k-means",
          "name": "Clustering: k-means",
          "requires": ["types-of-learning"]
        }
      ]
    },
    {
      "id": "neural-networks",
      "name": "Neural Networks and Deep Learning",
      "hours": 10,
      "topics": [
        {
          "id": "perceptron",
          "name": "The perceptron",
          "requires": ["linear-regression-ml"]
        },
        {
          "id": "gradient-descent",
          "name": "Gradient descent and the delta rule",
          "requires": ["linear-regression-ml"]
        },
        {
          "id": "backpropagation",
          "name": "Multilayer networks and backpropagation",
          "requires": ["perceptron", "gradient-descent"]
        },
        {
          "id": "cnn",
          "name": "Convolutional neural networks",
          "requires": ["backpropagation"]
        },
        {
          "id": "reinforcement-learning",
          "name": "Reinforcement learning and Q-learning",
          "requires": ["types-of-learning"]
        }
      ]
    }
  ]
}

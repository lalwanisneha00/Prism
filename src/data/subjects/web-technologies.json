{
  "id": "web-technologies",
  "name": "Web Technologies",
  "field": "Computer Science",
  "tier": "sourced",
  "branches": ["ce", "ict"],
  "semesters": [6],
  "syllabusSource": {
    "kind": "university",
    "title": "AKTU (AICTE model curriculum) B.Tech 3rd year CSE (AI & ML), 2022-23: KCS602 Web Technology",
    "url": "https://aktu.ac.in/pdf/syllabus/syllabus2223/B.Tech._3rd_Yr_CSE(AIML)_2022_23_revised_.pdf",
    "note": "Units I–V (the Java-specific units are taught through their general web concepts: servers, sessions, database access)."
  },
  "visualSet": "computing",
  "chapters": [
    {
      "id": "web-intro",
      "name": "Introduction to the Web",
      "hours": 6,
      "topics": [
        {
          "id": "internet-web-history",
          "name": "The Internet and the World Wide Web; client–server computing"
        },
        {
          "id": "http-protocol",
          "name": "HTTP: requests, responses, methods and status codes",
          "requires": ["internet-web-history"]
        }
      ]
    },
    {
      "id": "web-page-design",
      "name": "Web Page Design",
      "hours": 8,
      "topics": [
        {
          "id": "html-basics",
          "name": "HTML: structure, lists, tables, images and forms",
          "requires": ["internet-web-history"]
        },
        {
          "id": "css",
          "name": "CSS: selectors, the box model and layout",
          "requires": ["html-basics"]
        },
        {
          "id": "xml-dtd",
          "name": "XML, DTD and XML Schema",
          "requires": ["html-basics"]
        },
        {
          "id": "dom-sax",
          "name": "DOM and SAX parsing",
          "requires": ["xml-dtd"]
        }
      ]
    },
    {
      "id": "scripting",
      "name": "Client-side Scripting",
      "hours": 8,
      "topics": [
        {
          "id": "javascript-basics",
          "name": "JavaScript: statements, functions and objects",
          "requires": ["html-basics"]
        },
        {
          "id": "dom-events",
          "name": "Manipulating the DOM and handling events",
          "requires": ["javascript-basics", "dom-sax"]
        },
        {
          "id": "ajax",
          "name": "AJAX and asynchronous requests",
          "requires": ["dom-events", "http-protocol"]
        }
      ]
    },
    {
      "id": "server-side",
      "name": "Server-side Programming",
      "hours": 10,
      "topics": [
        {
          "id": "sockets-urls",
          "name": "Internet addressing, URLs and sockets",
          "requires": ["http-protocol"]
        },
        {
          "id": "servlets-lifecycle",
          "name": "Servlets and the request life cycle",
          "requires": ["http-protocol"]
        },
        {
          "id": "sessions-cookies",
          "name": "Session tracking and cookies",
          "requires": ["servlets-lifecycle"]
        },
        {
          "id": "server-pages",
          "name": "Server pages (JSP) and templates",
          "requires": ["servlets-lifecycle"]
        },
        {
          "id": "database-connectivity",
          "name": "Database connectivity (JDBC) and prepared statements",
          "requires": ["servlets-lifecycle"]
        },
        {
          "id": "javabeans-components",
          "name": "Components: JavaBeans and Enterprise beans",
          "requires": ["servlets-lifecycle"]
        }
      ]
    }
  ]
}

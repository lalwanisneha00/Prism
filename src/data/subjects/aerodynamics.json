{
  "id": "aerodynamics",
  "name": "Aerodynamics",
  "field": "Aerospace Engineering",
  "tier": "sourced",
  "branches": ["aero"],
  "semesters": [4],
  "syllabusSource": {
    "kind": "university",
    "title": "Anna University B.E. Aerospace Engineering (R2017): AC8401 Aerodynamics",
    "url": "https://cac.annauniv.edu/aidetails/afug_2017_fu/14.%20B.E.%20Aerospace%20Engg.pdf",
    "note": "All five units of AC8401."
  },
  "visualSet": "fluids",
  "chapters": [
    {
      "id": "low-speed",
      "name": "Low-Speed Flow Fundamentals",
      "hours": 9,
      "topics": [
        {
          "id": "circulation-vorticity",
          "name": "Circulation, vorticity and Kelvin's theorem"
        },
        {
          "id": "elementary-flows",
          "name": "Elementary flows: uniform flow, source, sink, vortex and doublet",
          "requires": ["circulation-vorticity"]
        },
        {
          "id": "flow-past-cylinder",
          "name": "Flow past a cylinder with and without circulation",
          "requires": ["elementary-flows"]
        }
      ]
    },
    {
      "id": "airfoils",
      "name": "Airfoils and Wings",
      "hours": 18,
      "topics": [
        {
          "id": "kutta-joukowski",
          "name": "Kutta–Joukowski theorem and the Kutta condition",
          "requires": ["flow-past-cylinder"]
        },
        {
          "id": "airfoil-terminology-lift",
          "name": "Airfoil terminology, lift and the lift coefficient",
          "requires": ["kutta-joukowski"]
        },
        {
          "id": "thin-airfoil-theory",
          "name": "Thin airfoil theory",
          "requires": ["airfoil-terminology-lift"]
        },
        {
          "id": "lifting-line-induced-drag",
          "name": "Finite wings: lifting-line theory and induced drag",
          "requires": ["thin-airfoil-theory"]
        }
      ]
    },
    {
      "id": "compressible",
      "name": "Compressible Flow",
      "hours": 9,
      "topics": [
        {
          "id": "mach-number-regimes",
          "name": "Mach number and flow regimes"
        },
        {
          "id": "normal-oblique-shocks",
          "name": "Normal and oblique shocks; expansion waves",
          "requires": ["mach-number-regimes"]
        }
      ]
    }
  ]
}

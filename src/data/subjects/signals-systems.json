{
  "id": "signals-systems",
  "name": "Signals and Systems",
  "field": "Electronics Engineering",
  "tier": "sourced",
  "branches": ["ece", "ict", "ee"],
  "semesters": [3, 4],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Electronics & Communication Engineering (2018; copy hosted by Dibrugarh University): EC05 Signals and Systems",
    "url": "https://oldweb.dibru.ac.in/wp-content/uploads/2020/12/ECE-Model-curriculum-2018-BATCH-ONWARDS_Modified.pdf",
    "note": "All units of EC05."
  },
  "visualSet": "signals",
  "chapters": [
    {
      "id": "signal-basics",
      "name": "Signals and System Properties",
      "hours": 6,
      "topics": [
        {
          "id": "signal-classification",
          "name": "Continuous and discrete; energy and power signals"
        },
        {
          "id": "system-properties",
          "name": "Linearity, time-invariance, causality and stability",
          "requires": ["signal-classification"]
        }
      ]
    },
    {
      "id": "lti-systems",
      "name": "LTI Systems and Convolution",
      "hours": 6,
      "topics": [
        {
          "id": "impulse-response",
          "name": "Impulse and step response",
          "requires": ["system-properties"]
        },
        {
          "id": "convolution",
          "name": "Convolution",
          "requires": ["impulse-response"]
        },
        {
          "id": "differential-difference-equations",
          "name": "Differential and difference equation models",
          "requires": ["impulse-response"]
        }
      ]
    },
    {
      "id": "fourier-analysis",
      "name": "Fourier Analysis",
      "hours": 10,
      "topics": [
        {
          "id": "fourier-series-signals",
          "name": "Fourier series of periodic signals",
          "requires": ["signal-classification"]
        },
        {
          "id": "fourier-transform",
          "name": "The Fourier transform and its properties",
          "requires": ["fourier-series-signals"]
        },
        {
          "id": "frequency-response",
          "name": "Frequency response: magnitude and phase",
          "requires": ["fourier-transform", "impulse-response"]
        },
        {
          "id": "dtft-dft",
          "name": "DTFT and DFT; Parseval's theorem",
          "requires": ["fourier-transform"]
        }
      ]
    },
    {
      "id": "laplace-z",
      "name": "Laplace and z-Transforms",
      "hours": 8,
      "topics": [
        {
          "id": "laplace-systems",
          "name": "The Laplace transform, ROC, poles and zeros",
          "requires": ["fourier-transform"]
        },
        {
          "id": "z-transform",
          "name": "The z-transform and its ROC",
          "requires": ["laplace-systems"]
        },
        {
          "id": "state-space",
          "name": "State-space representation",
          "requires": ["differential-difference-equations"]
        }
      ]
    },
    {
      "id": "sampling",
      "name": "Sampling and Reconstruction",
      "hours": 6,
      "topics": [
        {
          "id": "sampling-theorem",
          "name": "The sampling theorem",
          "requires": ["fourier-transform"]
        },
        {
          "id": "aliasing",
          "name": "Aliasing",
          "requires": ["sampling-theorem"]
        },
        {
          "id": "reconstruction",
          "name": "Reconstruction: ideal interpolation and zero-order hold",
          "requires": ["sampling-theorem"]
        }
      ]
    }
  ]
}

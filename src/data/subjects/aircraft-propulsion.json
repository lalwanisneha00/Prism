{
  "id": "aircraft-propulsion",
  "name": "Aircraft Propulsion",
  "field": "Aerospace Engineering",
  "tier": "sourced",
  "branches": ["aero"],
  "semesters": [5],
  "syllabusSource": {
    "kind": "university",
    "title": "Anna University B.E. Aerospace Engineering (R2017): AC8501 Air Breathing Propulsion",
    "url": "https://cac.annauniv.edu/aidetails/afug_2017_fu/14.%20B.E.%20Aerospace%20Engg.pdf",
    "note": "All five units of AC8501."
  },
  "visualSet": "thermal",
  "chapters": [
    {
      "id": "engines",
      "name": "Gas Turbine Engines",
      "hours": 9,
      "topics": [
        {
          "id": "jet-engine-types",
          "name": "Turbojet, turbofan and turboprop engines"
        },
        {
          "id": "thrust-equation",
          "name": "Thrust equation and propulsive efficiency",
          "requires": ["jet-engine-types"]
        },
        {
          "id": "inlets",
          "name": "Subsonic and supersonic intakes",
          "requires": ["jet-engine-types"]
        }
      ]
    },
    {
      "id": "turbomachines",
      "name": "Compressors and Turbines",
      "hours": 18,
      "topics": [
        {
          "id": "centrifugal-axial-compressors",
          "name": "Centrifugal and axial compressors; surge and stall",
          "requires": ["thrust-equation"]
        },
        {
          "id": "axial-radial-turbines",
          "name": "Axial and radial turbines; blade cooling",
          "requires": ["centrifugal-axial-compressors"]
        }
      ]
    },
    {
      "id": "combustors-nozzles",
      "name": "Combustors, Nozzles and Ramjets",
      "hours": 18,
      "topics": [
        {
          "id": "combustors-afterburners",
          "name": "Combustion chambers and afterburners",
          "requires": ["thrust-equation"]
        },
        {
          "id": "exhaust-nozzles",
          "name": "Convergent and convergent–divergent exhaust nozzles",
          "requires": ["thrust-equation"]
        },
        {
          "id": "ramjets",
          "name": "Ramjet propulsion",
          "requires": ["exhaust-nozzles"]
        }
      ]
    }
  ]

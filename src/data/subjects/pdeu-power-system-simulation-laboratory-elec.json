          "requires": ["experiment-10-to-simulate-transient-stability-of-smib-system"]
        },
        {
          "id": "experiment-12-to-obtain-pv-and-qv-curve-to-analyze-voltage-s",
          "name": "To obtain PV and QV curve to analyze voltage stability of a test power system",

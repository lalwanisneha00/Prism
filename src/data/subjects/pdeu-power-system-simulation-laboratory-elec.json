          "number": 3,
          "requires": ["experiment-2-to-calculate-voltage-regulation-of-transmission"]
        },
        {
          "id": "experiment-4-to-simulate-transient-behaviour-of-long-transmi",
          "name": "To simulate transient behaviour of long transmission line.",
          "number": 4,
          "requires": ["experiment-3-to-perform-compensation-of-transmission-line-un"]
        },
        {
          "id": "experiment-5-to-obtain-bus-admittance-matrix-ybus-of-a-test",
          "name": "To obtain bus admittance matrix (Ybus) of a test power system.",
          "number": 5,
          "requires": ["experiment-4-to-simulate-transient-behaviour-of-long-transmi"]
        },
        {
          "id": "experiment-6-to-simulate-power-flow-analysis-using-gauss-sie",
          "name": "To simulate power flow analysis using Gauss-Siedel, Newton-Raphson and Fast Decoupled Methods.",
          "number": 6,
          "requires": ["experiment-5-to-obtain-bus-admittance-matrix-ybus-of-a-test"]
        },
        {
          "id": "experiment-7-to-perform-economic-operation-of-interconnected",
          "name": "To perform economic operation of interconnected power system without constraints and line losses.",
          "number": 7,
          "requires": ["experiment-6-to-simulate-power-flow-analysis-using-gauss-sie"]
        },
        {
          "id": "experiment-8-to-perform-economic-operation-of-interconnected",
          "name": "To perform economic operation of interconnected power system with constraints and line losses.",
          "number": 8,
          "requires": ["experiment-7-to-perform-economic-operation-of-interconnected"]
        },
        {
          "id": "experiment-9-to-simulate-symmetrical-fault-and-unsymmetrical",
          "name": "To simulate symmetrical fault and unsymmetrical faults for a test power system",
          "number": 9,
          "requires": ["experiment-8-to-perform-economic-operation-of-interconnected"]
        },
        {
          "id": "experiment-10-to-simulate-transient-stability-of-smib-system",
          "name": "To simulate transient stability of SMIB system using equal-area criteria for different large disturbances.",
          "number": 10,
          "requires": ["experiment-9-to-simulate-symmetrical-fault-and-unsymmetrical"]
        },
        {
          "id": "experiment-11-to-simulate-transient-stability-of-smib-by-sol",
          "name": "To simulate transient stability of SMIB by solving swing equation for different large disturbances.",

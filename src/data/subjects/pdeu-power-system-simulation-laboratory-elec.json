      "id": "experiments",
      "name": "Experiments",
      "topics": [
        {
          "id": "experiment-1-introduction-to-matlab-simulink-mipower-pscad-a",
          "name": "Introduction to MATLAB/Simulink, MiPower,PSCAD and PowerWorld software.",
          "number": 1
        },
        {
          "id": "experiment-2-to-calculate-voltage-regulation-of-transmission",
          "name": "To calculate voltage regulation of transmission line under different loading conditions.",
          "number": 2,
          "requires": ["experiment-1-introduction-to-matlab-simulink-mipower-pscad-a"]
        },
        {
          "id": "experiment-3-to-perform-compensation-of-transmission-line-un",

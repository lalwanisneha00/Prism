  "chapters": [
    {
      "id": "experiments",
      "name": "Experiments",
      "topics": [
        {
          "id": "experiment-1-introduction-to-computer-programming-getting-ac",
          "name": "Introduction to Computer Programming: Getting acquainted with Linux Terminal and basic commands, understanding compilation process through a simple C program, program execution flow, C Tokens, variables and keywords and identifiers, types of C constants and variables",
          "number": 1
        },
        {
          "id": "experiment-2-simple-and-formatted-input-output-operations-da",
          "name": "Simple and formatted Input Output Operations: Data types, Operators, Input /output statements in C, Formatted I/O, format specifiers, escaper sequences",
          "number": 2,
          "requires": ["experiment-1-introduction-to-computer-programming-getting-ac"]
        },
        {
          "id": "experiment-3-decision-making-and-branching-if-if-else-if-els",
          "name": "Decision making and branching: if, if-else, if-else ladder, switch, go to statement, conditional operator statement",
          "number": 3,
          "requires": ["experiment-2-simple-and-formatted-input-output-operations-da"]
        },
        {
          "id": "experiment-4-looping-control-structures-while-do-while-for-l",
          "name": "Looping control structures: while, do-while, for loop, Break statement, Continue statement",
          "number": 4,
          "requires": ["experiment-3-decision-making-and-branching-if-if-else-if-els"]
        },
        {
          "id": "experiment-5-basics-of-modular-programming-introduction-to-m",
          "name": "Basics of modular programming: Introduction to modular programming through basic function syntax, introduction to header file creation, difference between #include <filename> and #include “filename”",
          "number": 5,
          "requires": ["experiment-4-looping-control-structures-while-do-while-for-l"]
        },
        {
          "id": "experiment-6-derived-data-type-array-and-strings-one-dimensi",
          "name": "Derived Data Type: Array and Strings: One dimensional and multidimensional array, Declaration, initialization, Array Manipulations. Matrix operations, Basic Concepts, Inbuilt String manipulation with and without using inbuilt functions.",
          "number": 6,
          "requires": ["experiment-5-basics-of-modular-programming-introduction-to-m"]
        },
        {
          "id": "experiment-7-derived-data-type-structure-and-union-structure",
          "name": "Derived Data Type: Structure and Union: structure, arrays and structures, structures and functions, pointer to structure, self-referential structures, typedef, unions",
          "number": 7,
          "requires": ["experiment-6-derived-data-type-array-and-strings-one-dimensi"]
        },
        {
          "id": "experiment-8-functions-introduction-to-user-defined-function",
          "name": "Functions: Introduction to user defined functions, Types of Functions, Call by value-call by reference, static and external variables, header file creation, recursion, pointers to functions, arrays and functions",
          "number": 8,
          "requires": ["experiment-7-derived-data-type-structure-and-union-structure"]
        },
        {
          "id": "experiment-9-pointers-pointers-basics-use-of-and-operator-in",
          "name": "Pointers: Pointers basics, use of &, * operator in context to pointers, Pointer arithmetic, Array and String processing using pointer, pointer to pointer, Array of Pointers",
          "number": 9,
          "requires": ["experiment-8-functions-introduction-to-user-defined-function"]
        },
        {
          "id": "experiment-10-file-handling-in-c-file-handling-in-c-differen",
          "name": "File Handling in C: File handling in C, Different types of files, Operations on Files, File handling functions.",
          "number": 10,
          "requires": ["experiment-9-pointers-pointers-basics-use-of-and-operator-in"]
        }
      ]
    }
  ],

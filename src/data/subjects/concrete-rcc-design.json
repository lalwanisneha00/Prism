    "note": "All units of PCC-02; working stress, limit state and prestressed concrete from PCC-10."
  },
  "visualSet": "civil",
  "chapters": [
    {
      "id": "concrete-ingredients",
      "name": "Cement, Aggregates and Admixtures",
      "hours": 6,
      "topics": [
        {
          "id": "portland-cement-types",
          "name": "Portland cement: hydration and types"
        },
        {
          "id": "aggregates",
          "name": "Fine and coarse aggregates and their tests",
          "requires": ["portland-cement-types"]
        },
        {
          "id": "admixtures",
          "name": "Admixtures and supplementary materials: fly ash, GGBS, silica fume",
          "requires": ["portland-cement-types"]
        }
      ]
    },
    {
      "id": "concrete-properties",
      "name": "Fresh and Hardened Concrete",
      "hours": 10,
      "topics": [
        {
          "id": "workability-slump",
          "name": "Workability and the slump test; water–cement ratio",

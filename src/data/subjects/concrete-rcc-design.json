{
  "id": "concrete-rcc-design",
  "name": "Concrete Technology and RCC Design",
  "field": "Civil Engineering",
  "tier": "sourced",
  "branches": ["civil"],
  "semesters": [3, 5],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Civil Engineering (2024): PCC-02 Concrete Technology and PCC-10 Structural Design-I",

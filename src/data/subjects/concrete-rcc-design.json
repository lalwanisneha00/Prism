        },
        {
          "id": "concrete-strength-durability",
          "name": "Strength, durability and curing",
          "requires": ["workability-slump"]
        },
        {
          "id": "mix-design",
          "name": "Concrete mix design",
          "requires": ["concrete-strength-durability"]
        },
        {
          "id": "special-concretes",
          "name": "Special concretes: self-compacting, fibre-reinforced, high-performance, ready-mix",
          "requires": ["concrete-strength-durability"]
        },
        {
          "id": "concrete-ndt",
          "name": "Non-destructive testing of concrete",
          "requires": ["concrete-strength-durability"]
        }
      ]
    },
    {
      "id": "rcc-design",
      "name": "Design of Reinforced Concrete",

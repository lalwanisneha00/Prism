{
  "id": "engineering-materials",
  "name": "Engineering Materials",
  "field": "Mechanical Engineering",
  "tier": "sourced",
  "branches": ["me", "civil"],
  "semesters": [4],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE revised Model Curriculum for UG Degree Course in Mechanical Engineering: PCC-ME 205 Engineering Materials and Applications",
    "url": "https://www.aicte.gov.in/sites/default/files/Final_Mechanical%20Engg.pdf",
    "note": "All modules of PCC-ME 205."
  },
  "visualSet": "chemistry",
  "chapters": [
    {
      "id": "materials-classes",
      "name": "Classes of Materials and Selection",
      "hours": 5,
      "topics": [
        {
          "id": "material-classes-selection",
          "name": "Metals, polymers, ceramics and composites; Ashby charts"
        },
        {
          "id": "crystal-structures-defects",
          "name": "Crystal structures and imperfections",
          "requires": ["material-classes-selection"]
        }
      ]
    },
    {
      "id": "mechanical-testing",
      "name": "Mechanical Properties and Testing",
      "hours": 8,
      "topics": [
        {
          "id": "tensile-test-curves",
          "name": "Tensile test: engineering and true stress–strain, yield, ductility, toughness",
          "requires": ["material-classes-selection"]
        },
        {
          "id": "hardness-tests",
          "name": "Hardness tests: Brinell, Rockwell and Vickers",
          "requires": ["tensile-test-curves"]
        },
        {
          "id": "fatigue-creep-fracture",
          "name": "Fatigue (S–N curve), creep and fracture",
          "requires": ["tensile-test-curves"]
        },
        {
          "id": "ndt-methods",
          "name": "Non-destructive testing",
          "requires": ["tensile-test-curves"]
        }
      ]
    },
    {
      "id": "metals-alloys",
      "name": "Phase Diagrams, Steels and Alloys",
      "hours": 10,
      "topics": [
        {
          "id": "phase-diagrams-lever-rule",
          "name": "Binary phase diagrams and the lever rule",
          "requires": ["crystal-structures-defects"]
        },
        {
          "id": "iron-carbon-diagram",
          "name": "The iron–iron carbide diagram",
          "requires": ["phase-diagrams-lever-rule"]
        },
        {
          "id": "ttt-diagrams",
          "name": "TTT diagrams and microstructures",
          "requires": ["iron-carbon-diagram"]
        },
        {
          "id": "steels-alloys",
          "name": "Plain-carbon, stainless and tool steels; copper, aluminium and titanium alloys",
          "requires": ["iron-carbon-diagram"]
        }
      ]
    },
    {
      "id": "heat-treatment",
      "name": "Heat Treatment",
      "hours": 6,
      "topics": [
        {
          "id": "annealing-normalising",
          "name": "Annealing, normalising, hardening and tempering",
          "requires": ["ttt-diagrams"]
        },
        {
          "id": "case-hardening",
          "name": "Case hardening: carburising, nitriding, induction and flame hardening",
          "requires": ["annealing-normalising"]
        }
      ]
    },
    {
      "id": "non-metals",
      "name": "Polymers, Ceramics, Composites and Functional Materials",
      "hours": 8,
      "topics": [
        {
          "id": "polymers-engg",
          "name": "Polymers: classification and applications",
          "requires": ["material-classes-selection"]
        },
        {
          "id": "ceramics-glasses",
          "name": "Ceramics and glasses",
          "requires": ["material-classes-selection"]
        },
        {
          "id": "composites",
          "name": "Composite materials: matrix and reinforcement",
          "requires": ["material-classes-selection"]
        },
        {
          "id": "smart-materials",
          "name": "Smart materials: piezoelectric and shape-memory alloys",
          "requires": ["material-classes-selection"]
        }
      ]
    }
  ]
}

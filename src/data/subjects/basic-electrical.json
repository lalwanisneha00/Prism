{
  "id": "basic-electrical",
  "name": "Basic Electrical Engineering",
  "field": "Electrical Engineering",
  "tier": "sourced",
  "branches": ["all"],
  "semesters": [1, 2],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree Courses in Engineering & Technology, Vol. I (Jan 2018): Basic Electrical Engineering (ESC101)",
    "url": "https://www.aicte.gov.in/sites/default/files/ug-vol1.pdf",
    "note": "Modules 1-6 of AICTE ESC101; magnetic circuits and DC machine basics from GCE Kalahandi's AICTE-model Basic Electrical Engineering (https://www.gcekjr.ac.in/pdf/news/2018/2758Proposed_First_Year_BTech_Syllabus_As_Per_AICTE_Model_Curriculum.pdf)."
  },
  "visualSet": "circuits",
  "chapters": [
    {
      "id": "dc-circuits",
      "name": "DC Circuits",
      "hours": 8,
      "topics": [
        {
          "id": "circuit-elements-sources",
          "name": "Circuit elements (R, L, C) and voltage and current sources"
        },
        {
          "id": "kirchhoffs-laws-bee",
          "name": "Ohm's law and Kirchhoff's current and voltage laws",
          "requires": ["circuit-elements-sources"]
        },
        {
          "id": "node-mesh-analysis",
          "name": "Node voltage and mesh current analysis",
          "requires": ["kirchhoffs-laws-bee"]
        },
        {
          "id": "superposition-theorem",
          "name": "Superposition theorem",
          "requires": ["node-mesh-analysis"]
        },
        {
          "id": "thevenin-norton",
          "name": "Thevenin's and Norton's theorems",
          "requires": ["superposition-theorem"]
        },
        {
          "id": "rl-rc-transients",
          "name": "Time-domain analysis of first-order RL and RC circuits",
          "requires": ["kirchhoffs-laws-bee"]
        }
      ]
    },
    {
      "id": "ac-circuits",
      "name": "Single-phase AC Circuits",
      "hours": 8,
      "topics": [
        {
          "id": "sinusoidal-waveforms",
          "name": "Sinusoidal waveforms: average, peak and rms values"
        },
        {
          "id": "phasors-j-operator",
          "name": "Phasors, the j operator, rectangular and polar forms",
          "requires": ["sinusoidal-waveforms"]
        },
        {
          "id": "rlc-ac-analysis",
          "name": "Single-phase R, L, C, RL, RC and RLC circuits",
          "requires": ["phasors-j-operator"]
        },
        {
          "id": "ac-power-factor",
          "name": "Real, reactive and apparent power; power factor",
          "requires": ["rlc-ac-analysis"]
        },
        {
          "id": "ac-resonance",
          "name": "Series and parallel resonance",
          "requires": ["rlc-ac-analysis"]
        }
      ]
    },
    {
      "id": "three-phase",
      "name": "Three-phase Circuits",
      "hours": 5,
      "topics": [
        {
          "id": "three-phase-generation",
          "name": "Three-phase emf generation"
        },
        {
          "id": "star-delta",
          "name": "Star and delta connections and conversions",
          "requires": ["three-phase-generation"]
        },
        {
          "id": "balanced-three-phase",
          "name": "Balanced three-phase circuits and phasor diagrams",
          "requires": ["star-delta"]
        },
        {
          "id": "three-phase-power-measurement",
          "name": "Measurement of three-phase power",
          "requires": ["balanced-three-phase"]
        }
      ]
    },
    {
      "id": "magnetic-circuits",
      "name": "Magnetic Circuits",
      "hours": 5,
      "topics": [
        {
          "id": "mmf-reluctance",
          "name": "MMF, flux, reluctance and inductance"
        },
        {
          "id": "bh-curve-hysteresis",
          "name": "Magnetic materials, B-H characteristics and hysteresis loss",
          "requires": ["mmf-reluctance"]
        },
        {
          "id": "series-parallel-magnetic-circuits",
          "name": "Series and parallel magnetic circuits",
          "requires": ["mmf-reluctance"]
        }
      ]
    },
    {
      "id": "transformers",
      "name": "Transformers",
      "hours": 6,
      "topics": [
        {
          "id": "ideal-practical-transformer",
          "name": "Construction and working; ideal and practical transformers"
        },
        {
          "id": "transformer-equivalent-circuit",
          "name": "Equivalent circuit and phasor diagram",
          "requires": ["ideal-practical-transformer"]
        },
        {
          "id": "transformer-losses-efficiency",
          "name": "Losses, regulation and efficiency",
          "requires": ["transformer-equivalent-circuit"]
        },
        {
          "id": "auto-three-phase-transformers",
          "name": "Auto-transformer and three-phase transformer connections",
          "requires": ["ideal-practical-transformer"]
        }
      ]
    },
    {
      "id": "electrical-machines",
      "name": "Electrical Machines",
      "hours": 8,
      "topics": [
        {
          "id": "rotating-magnetic-field",
          "name": "Rotating magnetic fields"
        },
        {
          "id": "three-phase-induction-motor",
          "name": "Three-phase induction motor: construction, working and torque-slip",
          "requires": ["rotating-magnetic-field"]
        },
        {
          "id": "induction-motor-starting-speed",
          "name": "Losses, efficiency, starting and speed control of induction motors",
          "requires": ["three-phase-induction-motor"]
        },
        {
          "id": "single-phase-induction-motor",
          "name": "Single-phase induction motor",
          "requires": ["three-phase-induction-motor"]
        },
        {
          "id": "dc-machines",
          "name": "DC machines: emf and torque equations, excitation, speed control",
          "requires": ["mmf-reluctance"]
        },
        {
          "id": "synchronous-generator",
          "name": "Construction and working of synchronous generators",
          "requires": ["rotating-magnetic-field"]
        }
      ]
    },
    {
      "id": "power-converters",
      "name": "Power Converters",
      "hours": 6,
      "topics": [
        {
          "id": "buck-boost-converters",
          "name": "DC-DC buck and boost converters; duty ratio control"
        },
        {
          "id": "voltage-source-inverters",
          "name": "Single- and three-phase voltage source inverters; sinusoidal modulation",
          "requires": ["buck-boost-converters"]
        }
      ]
    },
    {
      "id": "electrical-installations",
      "name": "Electrical Installations",
      "hours": 6,
      "topics": [
        {
          "id": "lt-switchgear",
          "name": "LT switchgear: SFU, MCB, ELCB, MCCB"
        },
        {
          "id": "wires-cables-earthing",
          "name": "Wires, cables and earthing",
          "requires": ["lt-switchgear"]
        },
        {
          "id": "batteries",
          "name": "Types and characteristics of batteries"
        },
        {
          "id": "energy-consumption-pf-improvement",
          "name": "Energy consumption, power factor improvement and battery backup calculations",
          "requires": ["batteries"]
        }
      ]
    }
  ]
}

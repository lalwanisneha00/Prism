{
  "id": "building-materials",
  "name": "Building Materials and Testing",
  "field": "Civil Engineering",
  "tier": "sourced",
  "branches": ["civil"],
  "semesters": [3],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Civil Engineering (2024): ESC07 Civil Engineering Materials, Testing and Evaluation",
    "url": "https://www.aicte.gov.in/sites/default/files/AICTE%20Model%20Curriculum%20_UG_Civil_2024.pdf",
    "note": "All modules and the listed tests of ESC07."
  },
  "visualSet": "civil",
  "chapters": [
    {
      "id": "materials-overview",
      "name": "Civil Engineering Materials",
      "hours": 10,
      "topics": [
        {
          "id": "bricks-stones",
          "name": "Bricks and building stones: properties and tests"
        },
        {
          "id": "cement-lime-mortar",
          "name": "Cement, lime and mortar",
          "requires": ["bricks-stones"]
        },
        {
          "id": "timber",
          "name": "Timber: seasoning and defects",
          "requires": ["bricks-stones"]
        },
        {
          "id": "structural-steel-bm",
          "name": "Structural steel and other metals"
        },
        {
          "id": "bitumen-polymers-bm",
          "name": "Bitumen, polymers and composites in construction"
        }
      ]
    },
    {
      "id": "mechanical-testing-bm",
      "name": "Mechanical Testing",
      "hours": 10,
      "topics": [
        {
          "id": "tension-test-bm",
          "name": "Tension test, elastic and plastic behaviour; true stress–strain",
          "requires": ["structural-steel-bm"]
        },
        {
          "id": "compression-shear-tests",
          "name": "Compression, direct shear, bending and torsion tests",
          "requires": ["tension-test-bm"]
        },
        {
          "id": "hardness-impact",
          "name": "Hardness and impact tests; ductile-to-brittle transition",
          "requires": ["tension-test-bm"]
        },
        {
          "id": "fatigue-creep-fracture-bm",
          "name": "Fatigue, creep and fracture toughness",
          "requires": ["tension-test-bm"]
        }
      ]
    },
    {
      "id": "evaluation",
      "name": "Testing Concrete, Soil and Bitumen",
      "hours": 8,
      "topics": [
        {
          "id": "aggregate-gradation",
          "name": "Gradation of coarse and fine aggregates",
          "requires": ["bricks-stones"]
        },
        {
          "id": "concrete-tests-bm",
          "name": "Tests on fresh and hardened concrete",
          "requires": ["cement-lime-mortar"]
        },
        {
          "id": "marshall-mix",
          "name": "Tests on bitumen and the Marshall mix design",
          "requires": ["bitumen-polymers-bm"]
        }
      ]
    }
  ]
}

{
  "id": "petroleum-refining",
  "name": "Petroleum Refining and Petrochemicals",
  "field": "Petroleum Engineering",
  "tier": "sourced",
  "branches": ["petro", "chem"],
  "semesters": [7],
  "syllabusSource": {
    "kind": "university",
    "title": "Anna University B.Tech Petroleum Engineering (R2017): CH8075 Petroleum Refining and Petrochemicals",
    "url": "https://cac.annauniv.edu/aidetails/afug_2017_fu/03.Petrol%20Engg.pdf",
    "note": "All five units of CH8075."
  },
  "visualSet": "process",
  "chapters": [
    {
      "id": "crude",
      "name": "Crude Oil and Its Evaluation",
      "hours": 6,
      "topics": [
        {
          "id": "crude-composition",
          "name": "Crude oil composition and classification"
        },
        {
          "id": "product-tests",
          "name": "Testing petroleum products: flash point, octane and cetane numbers",
          "requires": ["crude-composition"]
        }
      ]
    },
    {
      "id": "separation",
      "name": "Distillation",
      "hours": 6,
      "topics": [
        {
          "id": "atmospheric-distillation",
          "name": "Atmospheric distillation and refinery fractions",
          "requires": ["crude-composition"]
        },
        {
          "id": "vacuum-distillation",
          "name": "Vacuum distillation",
          "requires": ["atmospheric-distillation"]
        }
      ]
    },
    {
      "id": "conversion",
      "name": "Conversion Processes",
      "hours": 10,
      "topics": [
        {
          "id": "thermal-cracking-coking",
          "name": "Thermal cracking, visbreaking and coking",
          "requires": ["vacuum-distillation"]
        },
        {
          "id": "fcc",
          "name": "Fluid catalytic cracking",
          "requires": ["thermal-cracking-coking"]
        },
        {
          "id": "hydrocracking",
          "name": "Hydrocracking",
          "requires": ["fcc"]
        },
        {
          "id": "catalytic-reforming",
          "name": "Catalytic reforming and aromatics",
          "requires": ["atmospheric-distillation"]
        }
      ]
    },
    {
      "id": "treating",
      "name": "Treatment Processes",
      "hours": 6,
      "topics": [
        {
          "id": "hydrodesulfurization",
          "name": "Sulphur removal: hydrodesulphurisation",
          "requires": ["atmospheric-distillation"]
        },
        {
          "id": "dewaxing-solvent",
          "name": "Solvent treating and dewaxing",
          "requires": ["vacuum-distillation"]
        }
      ]
    },
    {
      "id": "petrochemicals",
      "name": "Petrochemicals",
      "hours": 8,
      "topics": [
        {
          "id": "steam-cracking-olefins",
          "name": "Steam cracking of naphtha: ethylene and propylene",
          "requires": ["thermal-cracking-coking"]
        },
        {
          "id": "petrochemical-products",
          "name": "Petrochemical products: ethylene glycol, DMT and polymers",
          "requires": ["steam-cracking-olefins"]
        }
      ]
    }
  ]
}

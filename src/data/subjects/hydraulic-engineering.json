{
  "id": "hydraulic-engineering",
  "name": "Hydraulic Engineering",
  "field": "Civil Engineering",
  "tier": "sourced",
  "branches": ["civil"],
  "semesters": [4],
  "syllabusSource": {
    "kind": "aicte",
    "title": "AICTE Model Curriculum for UG Degree in Civil Engineering (2024): PCC-07 Hydraulic Engineering",
    "url": "https://www.aicte.gov.in/sites/default/files/AICTE%20Model%20Curriculum%20_UG_Civil_2024.pdf",
    "note": "All ten modules of PCC-07. Basic fluid mechanics (PCC-03) is in the shared Fluid Mechanics subject."
  },
  "visualSet": "fluids",
  "chapters": [
    {
      "id": "viscous-flow-hyd",
      "name": "Viscous Flow and Boundary Layers",
      "hours": 10,
      "topics": [
        {
          "id": "laminar-flow-plates-annulus",
          "name": "Laminar flow through pipes, annuli and parallel plates"
        },
        {
          "id": "laminar-turbulent-transition",
          "name": "Transition to turbulence and velocity distribution",
          "requires": ["laminar-flow-plates-annulus"]
        },
        {
          "id": "boundary-layer-separation",
          "name": "Boundary layer thickness, drag and separation",
          "requires": ["laminar-turbulent-transition"]
        },
        {
          "id": "hydraulic-similitude",
          "name": "Dimensional analysis and hydraulic models",
          "requires": ["laminar-flow-plates-annulus"]
        }
      ]
    },
    {
      "id": "open-channel",
      "name": "Open Channel Flow",
      "hours": 14,
      "topics": [
        {
          "id": "open-channel-vs-pipe",
          "name": "Open channel flow compared with pipe flow; channel types"
        },
        {
          "id": "manning-chezy",
          "name": "Uniform flow: Chézy and Manning equations; most economical section",
          "requires": ["open-channel-vs-pipe"]
        },
        {
          "id": "specific-energy-critical",
          "name": "Specific energy and critical flow",
          "requires": ["manning-chezy"]
        },
        {
          "id": "gradually-varied-flow",
          "name": "Gradually varied flow profiles",
          "requires": ["specific-energy-critical"]
        },
        {
          "id": "hydraulic-jump",
          "name": "Hydraulic jump",
          "requires": ["specific-energy-critical"]
        }
      ]
    },
    {
      "id": "pipes-cfd",
      "name": "Pipe Networks and Computation",
      "hours": 6,
      "topics": [
        {
          "id": "pipe-networks-losses",
          "name": "Head losses, pipes in series and parallel, pipe networks",
          "requires": ["laminar-turbulent-transition"]
        },
        {
          "id": "water-hammer",
          "name": "Water hammer",
          "requires": ["pipe-networks-losses"]
        },
        {
          "id": "cfd-intro-hyd",
          "name": "Introduction to computational fluid dynamics",
          "requires": ["pipe-networks-losses"]
        }
      ]
    }
  ]
}

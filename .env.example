# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so your keys never reach GitHub.

# Required for AI lessons. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-flash-latest)
GEMINI_MODEL=

# Optional fallback when Gemini's free quota is busy. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: which Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# Testing only: set to "fake" to stream a canned lesson without any API key.
# Never set this on the live site.
LLM_PROVIDER=

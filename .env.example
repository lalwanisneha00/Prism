# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so your keys never reach GitHub.

# Required for AI lessons. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-flash-latest)
GEMINI_MODEL=
# Optional: backup models tried in order when the main one is overloaded
# (default: gemini-flash-lite-latest,gemini-3.1-flash-lite)
GEMINI_FALLBACK_MODELS=

# Optional fallback when Gemini's free quota is busy. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: which Groq model to use (default: openai/gpt-oss-120b)
GROQ_MODEL=

# Optional extra free fallbacks, tried after Groq.
# Mistral free "Experiment" plan (phone check, no card): https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
# Optional (default: mistral-large-latest)
MISTRAL_MODEL=
# OpenRouter free models (about 50 requests a day, no card): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any model id ending in ":free" (default: google/gemma-4-31b-it:free)
OPENROUTER_MODEL=

# Testing only: set to "fake" to stream a canned lesson without any API key.
# Never set this on the live site.
LLM_PROVIDER=

# Accounts & sync (V2). Firebase console → Project settings → General → Your apps → Config.
# These are public by design (every visitor's browser receives them).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SECRET, server only. From the service-account key file (Project settings → Service accounts).
# Keep the private key in double quotes with its line breaks written as \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Feature flags (optional). "1" = on, "0" = off. Defaults: byo key on, slides on, redesign on, community off.
NEXT_PUBLIC_FLAG_BYO_KEY=
NEXT_PUBLIC_FLAG_SLIDES_PDF=
NEXT_PUBLIC_FLAG_REDESIGN=
NEXT_PUBLIC_FLAG_COMMUNITY=
